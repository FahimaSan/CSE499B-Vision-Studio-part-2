{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":10842490},{"sourceType":"datasetVersion","sourceId":18779079}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"source":"<a href=\"https://www.kaggle.com/code/alivehues/vision-studio-final?scriptVersionId=363735678\" target=\"_blank\"><img align=\"left\" alt=\"Kaggle\" title=\"Open in Kaggle\" src=\"https://kaggle.com/static/images/open-in-kaggle.svg\"></a>","metadata":{},"cell_type":"markdown"},{"id":"42410ec7-87ed-4687-8770-7ff131ebb926","cell_type":"code","source":"# ── Cell 0 · Dependencies (safe to re-run) ─────────────────────────────────\nimport sys, subprocess, importlib\n\nPKGS = [\n    (\"diffusers\", \"diffusers\"),\n    (\"transformers\", \"transformers\"),\n    (\"accelerate\", \"accelerate\"),\n    (\"safetensors\", \"safetensors\"),\n    (\"opencv-python-headless\", \"cv2\"),\n    (\"pillow\", \"PIL\"),\n    (\"gradio\", \"gradio\"),\n    (\"mediapipe\", \"mediapipe\"),\n    (\"dspy-ai\", \"dspy\"),\n    (\"scikit-image\", \"skimage\"),\n    (\"scipy\", \"scipy\"),\n    (\"pandas\", \"pandas\"),\n]\n\ndef have(mod):\n    try:\n        importlib.import_module(mod)\n        return True\n    except Exception:\n        return False\n\nfor pip_name, mod in PKGS:\n    if have(mod):\n        print(\"ok      \", mod)\n        continue\n    print(\"installing\", pip_name, \"...\")\n    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", pip_name], check=False)\n    print(\"ok      \" if have(mod) else \"FAILED  \", mod)\n\nprint(\"\\nCell 0 complete\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:19:48.635471Z","iopub.execute_input":"2026-08-20T07:19:48.636177Z","iopub.status.idle":"2026-08-20T07:21:05.998553Z","shell.execute_reply.started":"2026-08-20T07:19:48.636146Z","shell.execute_reply":"2026-08-20T07:21:05.997663Z"}},"outputs":[{"name":"stdout","text":"ok       diffusers\nok       transformers\nok       accelerate\nok       safetensors\nok       cv2\nok       PIL\nok       gradio\ninstalling mediapipe ...\n   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 37.9/37.9 MB 55.7 MB/s eta 0:00:00\n   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 137.4/137.4 kB 8.6 MB/s eta 0:00:00\n","output_type":"stream"},{"name":"stderr","text":"ERROR: pip's dependency resolver does not currently take into account all the packages that are installed. This behaviour is the source of the following dependency conflicts.\ndopamine-rl 4.1.2 requires gym<=0.25.2, but you have gym 0.26.2 which is incompatible.\n","output_type":"stream"},{"name":"stdout","text":"ok       mediapipe\ninstalling dspy-ai ...\n   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 413.7/413.7 kB 14.2 MB/s eta 0:00:00\n   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 45.5/45.5 kB 2.4 MB/s eta 0:00:00\n   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 51.2/51.2 kB 2.2 MB/s eta 0:00:00\nok       dspy\nok       skimage\nok       scipy\nok       pandas\n\nCell 0 complete\n","output_type":"stream"}],"execution_count":1},{"id":"3c8078d7-9897-4879-ba00-48e32583f35f","cell_type":"markdown","source":"# Vision Studio\n\nDescribe a change to a face in ordinary English. The system works out which part of the face to\nedit, writes two versions of the prompt — your wording and a rewritten one — and renders several\noptions from each. You choose.\n\n**Setup**\n\n1. Right panel: **Accelerator → GPU**, **Internet → On**\n2. Add-ons → Secrets → `GEMINI_API_KEY` (free, no card: <https://aistudio.google.com/apikey>),\n   attached to this notebook\n3. **+ Add Data**: a face dataset, and `final_dataset.csv` if you have it\n\nThen run cells 1–12 in order. Cell 12 launches the app.\n\n**What the scored dataset adds.** Cell 8 mines 45 human-validated prompts from it. Eight become\nfew-shot demonstrations that the rewriter sees before writing anything; the rest become a\nsuggestion library, offered when your request resembles one already scored. Without the dataset\nthe rewriter still works, just zero-shot.","metadata":{}},{"id":"8cac6de8-f716-476c-b814-decc627a6d81","cell_type":"markdown","source":"## 2 · Settings and paths\n\n**Check:** prints `device : cuda`.","metadata":{}},{"id":"83f6a711-0ddb-4480-9d3e-48709faae624","cell_type":"code","source":"# ── Cell 1 · Imports, device, paths, run config ────────────────────────────\nimport os, gc, io, json, math, time, uuid, glob, base64, hashlib, random\nimport datetime, pathlib, warnings, csv, re\nwarnings.filterwarnings(\"ignore\")\n\nimport numpy as np\nimport pandas as pd\nimport cv2\nimport torch\nfrom PIL import Image, ImageDraw, ImageFilter\n\nDEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nDTYPE  = torch.float16 if DEVICE == \"cuda\" else torch.float32\n\n# ---- project root -------------------------------------------------------\nROOT   = pathlib.Path(os.environ.get(\"VS_ROOT\", \"/kaggle/working/vs_dspy\"))\nIMG    = ROOT / \"images\"        # source / mask / arm A / arm B PNGs\nPACKS  = ROOT / \"packs\"         # generated annotation HTML files\nANNOT  = ROOT / \"annotations\"   # CSVs returned by annotators\nfor d in (ROOT, IMG, PACKS, ANNOT):\n    d.mkdir(parents=True, exist_ok=True)\n\nPAIRS_CSV    = ROOT / \"pairs.csv\"\nMANIFEST_CSV = ROOT / \"pack_manifest.csv\"\nFINAL_CSV    = ROOT / \"final_dataset.csv\"\n\n# ---- render config: FIXED across both arms, recorded on every row -------\nRENDER = dict(\n    model_key = \"realistic-vision-1.5-inpaint\",\n    repo      = \"Uminosachi/realisticVisionV51_v51VAE-inpainting\",\n    size      = 512,\n    steps     = 28,\n    guidance  = 7.0,\n    texture_addback = 0.30,\n)\n\n# Identity anchor appended to BOTH arms. It is part of the rendering harness,\n# not part of what DSPy is being evaluated on, so it must be identical in A and B\n# or the comparison is confounded.\nIDENTITY_ANCHOR = \"same person, preserve facial identity\"\n\n# Negative prompt used for arm A. DSPy may propose its own for arm B; if it does\n# not, arm B inherits this one so the arms differ only in the positive prompt.\nBASE_NEGATIVE = (\"different person, distorted face, deformed, extra limbs, \"\n                 \"plastic skin, waxy, airbrushed, over-smoothed, blurry, lowres, watermark, text\")\n\ndef now_iso():\n    return datetime.datetime.now().isoformat(timespec=\"seconds\")\n\ndef sha1_of(img):\n    b = io.BytesIO(); img.convert(\"RGB\").save(b, \"PNG\")\n    return hashlib.sha1(b.getvalue()).hexdigest()[:12]\n\nprint(\"device :\", DEVICE, \"| torch\", torch.__version__)\nprint(\"root   :\", ROOT)\nprint(\"Cell 1 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:06.00014Z","iopub.execute_input":"2026-08-20T07:21:06.000742Z","iopub.status.idle":"2026-08-20T07:21:06.021778Z","shell.execute_reply.started":"2026-08-20T07:21:06.000715Z","shell.execute_reply":"2026-08-20T07:21:06.021074Z"}},"outputs":[{"name":"stdout","text":"device : cuda | torch 2.10.0+cu128\nroot   : /kaggle/working/vs_dspy\nCell 1 complete\n","output_type":"stream"}],"execution_count":2},{"id":"a134ac04-9786-4442-9ea2-34f8a0da4c0e","cell_type":"markdown","source":"## 3 · Face mask\n\nMediaPipe finds 468 landmarks; the mask is composed from named parts, and a part is protected only if the edit does not target it.\n\n**Check:** prints `solutions` or `tasks`, not `haar`.","metadata":{}},{"id":"644cafc6-69fc-402e-a19c-f3bfcc359db3","cell_type":"code","source":"# ── Cell 2 · MediaPipe landmarks + COMPOSABLE part mask engine ─────────────\n#\n# ARCHITECTURAL CHANGE vs. the old notebook\n# -----------------------------------------\n# Old: REGION_PARTS mapped an edit to exactly ONE of 8 fixed regions, and\n#      _poly_mask() then unconditionally SUBTRACTED eyes+nose (PROTECT_IDX)\n#      for the \"face\" and \"lower_face\" regions. Consequence: asking for eye\n#      makeup on the \"face\" region produced a mask with the eyelids punched\n#      out, so the edit silently did nothing.\n#\n# New: an edit resolves to a SET of parts that are unioned, plus a\n#      CONDITIONAL protect set. A part is only protected if the edit does not\n#      target it. Full-face makeup therefore covers the whole oval (nose,\n#      cheeks, lids, lips) and protects only the eye apertures; a nose job\n#      targets the nose and protects nothing; a de-ageing edit covers the oval\n#      and protects apertures + nose geometry.\n#\n# Every resolved mask is returned with an info dict that is written to the\n# dataset, so masking is a recorded variable rather than a hidden one.\n\n# ---------------------------------------------------------------- landmarks\nNOSE_IDX      = [1,2,4,5,6,19,44,45,51,94,97,98,115,122,125,168,195,197,236,274,\n                 275,281,344,351,354,440,220,305]\nNOSE_CORE_IDX = [1,2,4,5,6,168,197,195,98,327,115,344]\nFOREHEAD_IDX  = [10,338,297,332,284,251,21,54,103,67,109,151,108,337,69,299,104,\n                 333,105,334,66,296,65,295,107,336,9,8]\nLEFT_CHEEK_IDX  = [116,117,118,119,120,100,142,36,205,50,187,123,147,213]\nRIGHT_CHEEK_IDX = [345,346,347,348,349,329,371,266,425,280,411,352,376,433]\nLEFT_JAW_IDX    = [172,136,150,149,176,58,132,215,177,147,213,123]\nRIGHT_JAW_IDX   = [397,365,379,378,400,288,361,435,401,366,433,352]\nCHIN_IDX        = [152,148,176,377,400,149,378,150,379,175,171,396]\nFACE_OVAL_IDX   = [10,338,297,332,284,251,389,356,454,323,361,288,397,365,379,378,\n                   400,377,152,148,176,149,150,136,172,58,132,93,234,127,162,21,54,\n                   103,67,109]\nLOWERFACE_IDX   = [234,93,132,58,172,136,150,149,176,148,152,377,400,378,379,365,\n                   397,288,361,323,454,425,205,50,101,36,206,203,423,266,280,411]\nUNDER_EYE_L_IDX = [230,231,232,233,228,229,25,110,24,23,22,26,112]\nUNDER_EYE_R_IDX = [450,451,452,453,448,449,255,339,254,253,252,256,341]\nNASOLABIAL_L_IDX= [129,203,206,216,207,187,205,50,101,118,117]\nNASOLABIAL_R_IDX= [358,423,426,436,427,411,425,280,330,347,346]\nLIPS_IDX        = [61,146,91,181,84,17,314,405,321,375,291,409,270,269,267,0,37,39,\n                   40,185,76,77,90,180,85,16,315,404,320,307,306,408,304,303,302,11,\n                   72,73,74,184]\n# lid + crease only (NOT the eyeball) — this is what eyeshadow needs\nEYELID_L_IDX = [33,246,161,160,159,158,157,173,133,225,224,223,222,221,189]\nEYELID_R_IDX = [263,466,388,387,386,385,384,398,362,445,444,443,442,441,413]\nBROW_L_IDX   = [46,53,52,65,55,70,63,105,66,107]\nBROW_R_IDX   = [276,283,282,295,285,300,293,334,296,336]\n# the eye OPENING (iris + sclera). Protected during makeup so eye colour and\n# gaze are never regenerated, while the lid above it stays editable.\nEYE_APER_L_IDX = [33,7,163,144,145,153,154,155,133,173,157,158,159,160,161,246]\nEYE_APER_R_IDX = [263,249,390,373,374,380,381,382,362,398,384,385,386,387,388,466]\n\nPART_GROUPS = {\n    \"face_oval\":  [FACE_OVAL_IDX],\n    \"lower_face\": [LOWERFACE_IDX],\n    \"forehead\":   [FOREHEAD_IDX],\n    \"cheeks\":     [LEFT_CHEEK_IDX, RIGHT_CHEEK_IDX],\n    \"nose\":       [NOSE_IDX],\n    \"lips\":       [LIPS_IDX],\n    \"eyelids\":    [EYELID_L_IDX, EYELID_R_IDX],\n    \"brows\":      [BROW_L_IDX, BROW_R_IDX],\n    \"jaw\":        [LEFT_JAW_IDX, RIGHT_JAW_IDX],\n    \"chin\":       [CHIN_IDX],\n    \"under_eye\":  [UNDER_EYE_L_IDX, UNDER_EYE_R_IDX],\n    \"nasolabial\": [NASOLABIAL_L_IDX, NASOLABIAL_R_IDX],\n    # protect-only parts\n    \"eye_aperture\": [EYE_APER_L_IDX, EYE_APER_R_IDX],\n    \"nose_core\":    [NOSE_CORE_IDX],\n}\n\n# --------------------------------------------------------------- backends\n_BACKEND = None; _FM = None; _TASK = None\n\ndef _init_backend():\n    global _BACKEND, _FM, _TASK\n    if _BACKEND is not None: return _BACKEND\n    try:\n        import mediapipe as mp\n        _FM = mp.solutions.face_mesh.FaceMesh(static_image_mode=True, max_num_faces=1,\n                                              refine_landmarks=True, min_detection_confidence=0.4)\n        _BACKEND = \"solutions\"; return _BACKEND\n    except Exception:\n        pass\n    try:\n        import mediapipe as mp, urllib.request\n        from mediapipe.tasks import python as mpp\n        from mediapipe.tasks.python import vision as mpv\n        p = str(ROOT / \"face_landmarker.task\")\n        if not os.path.exists(p):\n            urllib.request.urlretrieve(\n                \"https://storage.googleapis.com/mediapipe-models/face_landmarker/\"\n                \"face_landmarker/float16/1/face_landmarker.task\", p)\n        _TASK = mpv.FaceLandmarker.create_from_options(\n            mpv.FaceLandmarkerOptions(base_options=mpp.BaseOptions(model_asset_path=p), num_faces=1))\n        _BACKEND = \"tasks\"; return _BACKEND\n    except Exception:\n        pass\n    _BACKEND = \"haar\"; return _BACKEND\n\n_HAAR = cv2.CascadeClassifier(cv2.data.haarcascades + \"haarcascade_frontalface_default.xml\")\n\ndef get_landmarks(pil):\n    b = _init_backend(); rgb = np.array(pil.convert(\"RGB\")); H, W = rgb.shape[:2]\n    if b == \"solutions\":\n        r = _FM.process(rgb)\n        if not r.multi_face_landmarks: return None, b\n        return np.array([[p.x*W, p.y*H] for p in r.multi_face_landmarks[0].landmark], np.float32), b\n    if b == \"tasks\":\n        import mediapipe as mp\n        r = _TASK.detect(mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb))\n        if not r.face_landmarks: return None, b\n        return np.array([[p.x*W, p.y*H] for p in r.face_landmarks[0]], np.float32), b\n    return None, b\n\ndef _haar_rect(pil):\n    W, H = pil.size\n    gray = cv2.cvtColor(np.array(pil.convert(\"RGB\")), cv2.COLOR_RGB2GRAY)\n    f = _HAAR.detectMultiScale(gray, 1.05, 4, minSize=(40, 40))\n    if len(f) == 0:\n        fw, fh = int(W*0.6), int(H*0.6)\n        return ((W-fw)//2, int(H*0.18), fw, fh)\n    return tuple(max(f, key=lambda r: r[2]*r[3]))\n\n# ------------------------------------------------------------ mask builder\ndef _hull(size, pts, idxs, grow=0.10):\n    W, H = size; m = Image.new(\"L\", (W, H), 0)\n    idxs = [i for i in idxs if i < len(pts)]\n    if len(idxs) < 3: return m\n    sel = pts[idxs]\n    hull = cv2.convexHull(sel.astype(np.int32)).reshape(-1, 2)\n    cx, cy = float(sel[:, 0].mean()), float(sel[:, 1].mean())\n    poly = [(cx + (x-cx)*(1+grow), cy + (y-cy)*(1+grow)) for x, y in hull]\n    ImageDraw.Draw(m).polygon(poly, fill=255)\n    return m\n\ndef _union(size, pts, parts, grow):\n    acc = np.zeros((size[1], size[0]), np.uint8)\n    for part in parts:\n        for grp in PART_GROUPS.get(part, []):\n            acc = np.maximum(acc, np.array(_hull(size, pts, grp, grow)))\n    return acc\n\ndef _box_fallback(pil, parts):\n    \"\"\"No landmarks: draw a coarse ellipse so the app still runs.\"\"\"\n    W, H = pil.size; m = Image.new(\"L\", (W, H), 0); d = ImageDraw.Draw(m)\n    fx, fy, fw, fh = _haar_rect(pil)\n    if \"lips\" in parts and len(parts) == 1:\n        cx = fx + fw//2\n        d.ellipse([cx-int(fw*.22), fy+int(fh*.66), cx+int(fw*.22), fy+int(fh*.82)], fill=255)\n    elif set(parts) & {\"eyelids\", \"brows\"}:\n        for s in (-1, 1):\n            ex = fx + fw//2 + s*int(fw*.20)\n            d.ellipse([ex-int(fw*.16), fy+int(fh*.28), ex+int(fw*.16), fy+int(fh*.46)], fill=255)\n    elif \"nose\" in parts and len(parts) <= 2:\n        cx, cy = fx+fw//2, fy+int(fh*.50)\n        d.ellipse([cx-int(fw*.22), cy-int(fh*.24), cx+int(fw*.22), cy+int(fh*.24)], fill=255)\n    else:\n        pad = int(fw*0.10)\n        d.ellipse([max(0, fx-pad), max(0, fy-int(fh*.05)),\n                   min(W, fx+fw+pad), min(H, fy+fh+int(fh*.08))], fill=255)\n    return m.filter(ImageFilter.GaussianBlur(10))\n\ndef build_mask(pil, spec):\n    \"\"\"spec: dict(parts=[...], protect=[...], grow=float, blur=int, neck=bool)\n    Returns (PIL 'L' mask, info dict recorded in the dataset).\"\"\"\n    size = pil.size\n    parts   = list(spec.get(\"parts\", [\"face_oval\"]))\n    protect = [p for p in spec.get(\"protect\", []) if p not in parts]  # conditional\n    # SAFETY FLOOR: the eyeballs (iris + sclera) are never regenerated, no\n    # matter what was requested or what resolve_intent() decided to protect.\n    # No INTENT_RULES entry ever targets \"eye_aperture\" as a part, so this\n    # can never conflict with a genuine edit request.\n    if \"eye_aperture\" not in parts and \"eye_aperture\" not in protect:\n        protect = protect + [\"eye_aperture\"]\n    grow    = float(spec.get(\"grow\", 0.10))\n    blur    = int(spec.get(\"blur\", 8))\n    pts, backend = get_landmarks(pil)\n\n    if pts is None or len(pts) < 200:\n        m = _box_fallback(pil, parts)\n        used_backend = \"haar_fallback\"\n    else:\n        acc = _union(size, pts, parts, grow)\n        if spec.get(\"neck\"):\n            chin = pts[[i for i in CHIN_IDX if i < len(pts)]]\n            if len(chin):\n                tmp = Image.fromarray(acc)\n                cx = float(chin[:, 0].mean()); cy = float(chin[:, 1].max())\n                jw = float(chin[:, 0].max() - chin[:, 0].min()) or size[0]*0.25\n                ImageDraw.Draw(tmp).ellipse(\n                    [cx-jw*0.80, cy-jw*0.16, cx+jw*0.80, min(size[1], cy+jw*1.05)], fill=255)\n                acc = np.array(tmp)\n        if protect:\n            sub = _union(size, pts, protect, 0.06)\n            sub = np.array(Image.fromarray(sub).filter(ImageFilter.GaussianBlur(5)))\n            acc = np.clip(acc.astype(int) - sub.astype(int), 0, 255).astype(np.uint8)\n        m = Image.fromarray(acc).filter(ImageFilter.GaussianBlur(blur))\n        used_backend = backend\n\n    arr = np.array(m)\n    info = dict(\n        mask_parts    = \"|\".join(parts),\n        mask_protect  = \"|\".join(protect),\n        mask_grow     = grow,\n        mask_blur     = blur,\n        mask_neck     = bool(spec.get(\"neck\", False)),\n        mask_backend  = used_backend,\n        mask_coverage = round(float((arr > 32).mean()), 4),\n        mask_mean     = round(float(arr.mean()/255.0), 4),\n    )\n    return m, info\n\ndef mask_overlay(pil, mask, color=(255, 90, 30)):\n    base = np.array(pil.convert(\"RGB\"))\n    a = np.array(mask.convert(\"L\").resize(pil.size)) > 90\n    out = base.copy()\n    out[a] = (0.50*np.array(color) + 0.50*base[a]).astype(np.uint8)\n    edge = cv2.morphologyEx(a.astype(np.uint8), cv2.MORPH_GRADIENT,\n                            cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5)))\n    out[edge > 0] = color\n    return Image.fromarray(out)\n\n# ------------------------------------------------- compositing + texture\ndef composite(orig, gen, mask):\n    a = np.asarray(mask.convert(\"L\").resize(orig.size), np.float32)[:, :, None]/255.0\n    o = np.asarray(orig.convert(\"RGB\"), np.float32)\n    g = np.asarray(gen.convert(\"RGB\").resize(orig.size), np.float32)\n    return Image.fromarray((a*g + (1-a)*o).clip(0, 255).astype(np.uint8))\n\ndef texture_restore(orig, gen, mask, amount=0.30):\n    o = np.asarray(orig.convert(\"RGB\").resize(gen.size), np.float32)\n    g = np.asarray(gen.convert(\"RGB\"), np.float32)\n    hf = o - cv2.GaussianBlur(o, (0, 0), 3.0)\n    m = (np.asarray(mask.convert(\"L\").resize(gen.size), np.float32)/255.0)[:, :, None]\n    return Image.fromarray(np.clip(g + amount*hf*m, 0, 255).astype(np.uint8))\n\nprint(\"landmark backend:\", _init_backend())\nprint(\"parts available :\", \", \".join(sorted(PART_GROUPS)))\nprint(\"Cell 2 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:06.023028Z","iopub.execute_input":"2026-08-20T07:21:06.02329Z","iopub.status.idle":"2026-08-20T07:21:07.885117Z","shell.execute_reply.started":"2026-08-20T07:21:06.023271Z","shell.execute_reply":"2026-08-20T07:21:07.884348Z"}},"outputs":[{"name":"stdout","text":"landmark backend: tasks\nparts available : brows, cheeks, chin, eye_aperture, eyelids, face_oval, forehead, jaw, lips, lower_face, nasolabial, nose, nose_core, under_eye\nCell 2 complete\n","output_type":"stream"},{"name":"stderr","text":"WARNING: Logging before InitGoogle() is written to STDERR\nW0000 00:00:1787210467.841151     148 face_landmarker_graph.cc:180] Sets FaceBlendshapesGraph acceleration to xnnpack by default.\nINFO: Created TensorFlow Lite XNNPACK delegate for CPU.\nW0000 00:00:1787210467.857315     152 inference_feedback_manager.cc:121] Feedback manager requires a model with a single signature inference. Disabling support for feedback tensors.\nW0000 00:00:1787210467.877648     154 inference_feedback_manager.cc:121] Feedback manager requires a model with a single signature inference. Disabling support for feedback tensors.\n","output_type":"stream"}],"execution_count":3},{"id":"f10ed237-5894-4b8a-8f16-192aa680553c","cell_type":"markdown","source":"## 3b · Adaptive coverage mask\n\nExtension cell — adds new functions only, nothing above is modified.","metadata":{}},{"id":"c2907dab-d0d0-4858-84cf-84fab6f47386","cell_type":"code","source":"# ── Cell 2b · Adaptive coverage — weighted-tier mask (extension) ───────────\n#\n# WHY THIS CELL EXISTS\n# build_mask() (Cell 2) stays exactly as it is — every caller that depends on\n# it today (batch_generate, ui_generate, final_dataset.csv) is untouched.\n# This cell adds a SEPARATE builder, build_mask_tiered(), for the adaptive-\n# coverage path. It reuses the exact same landmark primitives (_hull, _union,\n# PART_GROUPS, CHIN_IDX) — only the way the hulls are combined is new.\n#\n# FIX (v2): the first version blurred the low-tier and high-tier layers\n# TOGETHER at the full `blur` radius before taking their max, which washed\n# the high-priority core down toward the low-tier weight whenever the core\n# was small relative to the blur radius — the edit map then showed almost no\n# visible red, just a flat amber wash, regardless of request. Fixed by\n# building each tier as its own binary layer, blurring EACH separately at a\n# radius scaled to that layer (the core keeps a tighter blur so its centre\n# stays close to HIGH_WEIGHT), and only then taking the max. The core is also\n# now guaranteed to sit strictly inside the base region (np.minimum) rather\n# than merely approximately inside it, so the ring is never negative.\n\nLOW_WEIGHT, HIGH_WEIGHT = 0.50, 1.00\nCORE_SHRINK = 0.18   # how much tighter the \"high priority\" core is than the base hull\n\ndef build_mask_tiered(pil, spec):\n    \"\"\"spec: same shape as build_mask()'s spec (parts, protect, grow, blur, neck).\n    Returns (PIL 'L' image holding a WEIGHTED 0-255 mask, info dict).\n    (weighted_mask_array > 0) reproduces build_mask()'s binary footprint,\n    so mask_coverage stays comparable across ablation conditions.\"\"\"\n    size = pil.size\n    parts   = list(spec.get(\"parts\", [\"face_oval\"]))\n    protect = [p for p in spec.get(\"protect\", []) if p not in parts]\n    # SAFETY FLOOR: same guarantee as build_mask() — eyeballs are always\n    # protected, regardless of what was requested.\n    if \"eye_aperture\" not in parts and \"eye_aperture\" not in protect:\n        protect = protect + [\"eye_aperture\"]\n    grow    = float(spec.get(\"grow\", 0.10))\n    blur    = int(spec.get(\"blur\", 8))\n    pts, backend = get_landmarks(pil)\n\n    if pts is None or len(pts) < 200:\n        base = _box_fallback(pil, parts)\n        arr = np.array(base).astype(np.float32) / 255.0 * HIGH_WEIGHT\n        cov = round(float((arr > 0.05).mean()), 4)\n        return Image.fromarray((arr * 255).astype(np.uint8)), dict(\n            mask_parts=\"|\".join(parts), mask_protect=\"|\".join(protect),\n            mask_grow=grow, mask_blur=blur, mask_neck=bool(spec.get(\"neck\", False)),\n            mask_backend=\"haar_fallback\", mask_coverage=cov, mask_mean=round(float(arr.mean()), 4),\n            tier_low=0.0, tier_high=cov)\n\n    low_full  = _union(size, pts, parts, grow)                       # base region, binary 0/255\n    high_core = _union(size, pts, parts, grow - CORE_SHRINK)         # tighter core, binary 0/255\n    high_core = np.minimum(high_core, low_full)                      # core is strictly inside the base\n    low_ring  = np.clip(low_full.astype(int) - high_core.astype(int), 0, 255).astype(np.uint8)\n\n    # blur each tier SEPARATELY, core at a tighter radius, so the core keeps a\n    # visible near-HIGH_WEIGHT centre instead of bleeding into the ring\n    ring_sigma = max(1.0, blur * 0.6)\n    core_sigma = max(1.0, blur * 0.35)\n    ring_soft = cv2.GaussianBlur(low_ring.astype(np.float32),  (0, 0), ring_sigma) / 255.0\n    core_soft = cv2.GaussianBlur(high_core.astype(np.float32), (0, 0), core_sigma) / 255.0\n\n    weighted = np.maximum(ring_soft * LOW_WEIGHT, core_soft * HIGH_WEIGHT)\n\n    if spec.get(\"neck\"):\n        chin = pts[[i for i in CHIN_IDX if i < len(pts)]]\n        if len(chin):\n            tmp = Image.new(\"L\", size, 0)\n            cx = float(chin[:, 0].mean()); cy = float(chin[:, 1].max())\n            jw = float(chin[:, 0].max() - chin[:, 0].min()) or size[0] * 0.25\n            ImageDraw.Draw(tmp).ellipse(\n                [cx - jw*0.80, cy - jw*0.16, cx + jw*0.80, min(size[1], cy + jw*1.05)], fill=255)\n            neck_soft = cv2.GaussianBlur(np.array(tmp).astype(np.float32), (0, 0), ring_sigma) / 255.0\n            weighted = np.maximum(weighted, neck_soft * LOW_WEIGHT)\n\n    if protect:\n        sub = _union(size, pts, protect, 0.06).astype(np.float32) / 255.0\n        sub_soft = cv2.GaussianBlur(sub, (0, 0), 2.5)\n        weighted = weighted * (1.0 - sub_soft)\n\n    arr = np.clip(weighted, 0, 1)\n    weighted_img = Image.fromarray((arr * 255).astype(np.uint8))\n\n    info = dict(\n        mask_parts    = \"|\".join(parts),\n        mask_protect  = \"|\".join(protect),\n        mask_grow     = grow,\n        mask_blur     = blur,\n        mask_neck     = bool(spec.get(\"neck\", False)),\n        mask_backend  = backend,\n        mask_coverage = round(float((arr > 0.05).mean()), 4),\n        mask_mean     = round(float(arr.mean()), 4),\n        tier_low      = round(float(((arr > 0.05) & (arr < LOW_WEIGHT + 0.05)).mean()), 4),\n        tier_high     = round(float((arr >= LOW_WEIGHT + 0.05).mean()), 4),\n    )\n    return weighted_img, info\n\ndef shrink_spec(spec, step=0.06, min_grow=-0.10):\n    \"\"\"Copy of spec with `grow` reduced. Used by the coverage-aware identity\n    guard (Cell 10b) to regenerate with a physically smaller edit region —\n    this is what makes mask coverage a first-class retry variable rather than\n    only diffusion strength.\"\"\"\n    s = dict(spec)\n    s[\"grow\"] = max(min_grow, float(spec.get(\"grow\", 0.10)) - step)\n    return s\n\ndef tiered_overlay(pil, weighted_mask, low_color=(255, 200, 60), high_color=(255, 60, 30)):\n    \"\"\"'Show Edit Map' visualization: untouched = original, low-priority tier\n    ramps to amber, high-priority core ramps to red — tied directly to\n    LOW_WEIGHT/HIGH_WEIGHT rather than arbitrary thresholds, so the two tiers\n    are visibly distinct whenever build_mask_tiered() actually produced two\n    distinct tiers (see the v2 fix above).\"\"\"\n    base = np.array(pil.convert(\"RGB\")).astype(np.float32)\n    arr = np.array(weighted_mask.convert(\"L\").resize(pil.size)).astype(np.float32) / 255.0\n    low_a  = np.clip(arr / LOW_WEIGHT, 0, 1)[:, :, None]\n    high_a = np.clip((arr - LOW_WEIGHT) / (HIGH_WEIGHT - LOW_WEIGHT), 0, 1)[:, :, None]\n    out = base * (1 - 0.45*low_a) + np.array(low_color) * (0.45*low_a)\n    out = out * (1 - 0.55*high_a) + np.array(high_color) * (0.55*high_a)\n    return Image.fromarray(out.clip(0, 255).astype(np.uint8))\n\nprint(\"Cell 2b complete — build_mask_tiered, shrink_spec, tiered_overlay\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:07.886605Z","iopub.execute_input":"2026-08-20T07:21:07.886805Z","iopub.status.idle":"2026-08-20T07:21:07.90413Z","shell.execute_reply.started":"2026-08-20T07:21:07.886788Z","shell.execute_reply":"2026-08-20T07:21:07.903437Z"}},"outputs":[{"name":"stdout","text":"Cell 2b complete — build_mask_tiered, shrink_spec, tiered_overlay\n","output_type":"stream"}],"execution_count":4},{"id":"62cc53fc-b930-48b5-9a4b-5285366167e8","cell_type":"markdown","source":"## 4 · Understanding the request","metadata":{}},{"id":"a0a2ca25-ef78-4c68-ae92-a2a17e938062","cell_type":"code","source":"# ── Cell 3 · Edit-intent parser: free text → mask spec ─────────────────────\n#\n# The user types anything (\"give her a smokey eye and red lips\"). This resolves\n# it to a part set + protect set + a default strength.\n#\n# Three things this has to get right, each of which is a bug if it doesn't:\n#\n#  1. WORD BOUNDARIES. Substring matching is unsafe on this vocabulary:\n#     \"important\" contains \"tan\", \"image\" contains \"age\", \"spotless\" contains\n#     \"spot\". Every keyword is compiled to a boundary-anchored regex.\n#\n#  2. PROTECT IS A UNION, NOT AN INTERSECTION. If any matched rule wants a part\n#     protected it stays protected, unless another rule explicitly targets it.\n#     With an intersection, \"smokey eye makeup and red lipstick\" ended up with\n#     nothing protected and the iris got regenerated.\n#\n#  3. GENERIC \"makeup\" MUST NOT SWALLOW SPECIFIC ONES. Bare \"makeup\" escalates\n#     to a whole-face mask only when no specific makeup rule matched, or when a\n#     genuine whole-face cue is present (foundation, contour, glam...).\n\ndef _rx(words):\n    return re.compile(r\"(?<![a-z])(\" + \"|\".join(re.escape(w) for w in words) + r\")(?![a-z])\", re.I)\n\nWHOLE_FACE_CUES = _rx([\"glam\", \"foundation\", \"contour\", \"contouring\", \"blush\", \"highlighter\",\n                       \"bronzer\", \"bridal\", \"full face\", \"full-face\", \"complexion\", \"base makeup\",\n                       \"whole face\", \"entire face\"])\nREMOVE_MAKEUP_RX = re.compile(\n    r\"(remove|without|no|take off|strip|clean off|free of)\\b[\\w\\s]{0,20}\\bmake[\\s-]?up|\"\n    r\"\\bmakeup[\\s-]?free\\b|\\bbare face\\b|\\bno cosmetics\\b\", re.I)\n\nINTENT_RULES = [\n    (\"remove_makeup\", REMOVE_MAKEUP_RX,\n        dict(parts=[\"face_oval\"], protect=[\"eye_aperture\"], grow=0.06, blur=9, strength=0.50)),\n\n    (\"eye_makeup\", _rx([\"eyeshadow\", \"eye shadow\", \"eyeliner\", \"eye liner\", \"mascara\", \"smokey\",\n                        \"smoky\", \"lashes\", \"eyelash\", \"eyelashes\", \"winged liner\", \"cut crease\",\n                        \"eye makeup\", \"kajal\", \"kohl\", \"eye make-up\"]),\n        dict(parts=[\"eyelids\", \"brows\"], protect=[\"eye_aperture\"], grow=0.14, blur=6, strength=0.46)),\n\n    (\"brows\", _rx([\"eyebrow\", \"eyebrows\", \"brow\", \"brows\", \"microblading\"]),\n        dict(parts=[\"brows\"], protect=[\"eye_aperture\"], grow=0.16, blur=5, strength=0.45)),\n\n    (\"lips\", _rx([\"lipstick\", \"lip gloss\", \"lip colour\", \"lip color\", \"lip tint\", \"lip liner\",\n                  \"lip filler\", \"fuller lips\", \"plumper lips\", \"plump lips\", \"matte lip\",\n                  \"lips\", \"lip\"]),\n        dict(parts=[\"lips\"], protect=[], grow=0.10, blur=5, strength=0.48)),\n\n    (\"full_makeup\", _rx([\"makeup\", \"make-up\", \"make up\", \"glam\", \"foundation\", \"contour\",\n                         \"contouring\", \"blush\", \"highlighter\", \"bronzer\", \"bridal\"]),\n        # nose is deliberately NOT protected: contour and highlight need the bridge\n        dict(parts=[\"face_oval\"], protect=[\"eye_aperture\"], grow=0.06, blur=9, strength=0.44)),\n\n    (\"beard\", _rx([\"beard\", \"stubble\", \"moustache\", \"mustache\", \"goatee\", \"facial hair\",\n                   \"shave\", \"shaven\", \"clean shaven\"]),\n        dict(parts=[\"lower_face\", \"chin\", \"jaw\", \"nasolabial\"], protect=[\"eye_aperture\"],\n             grow=0.10, blur=8, strength=0.52)),\n\n    (\"skin\", _rx([\"acne\", \"pimple\", \"pimples\", \"blemish\", \"blemishes\", \"spot\", \"spots\",\n                  \"clear skin\", \"smooth skin\", \"pores\", \"freckle\", \"freckles\", \"scar\",\n                  \"scars\", \"even skin tone\", \"complexion\", \"dark circles\"]),\n        dict(parts=[\"face_oval\"], protect=[\"eye_aperture\", \"lips\"], grow=0.05, blur=9, strength=0.46)),\n\n    (\"wrinkles\", _rx([\"wrinkle\", \"wrinkles\", \"botox\", \"fine lines\", \"smile lines\", \"crows feet\",\n                      \"crow's feet\", \"de-age\", \"deage\", \"younger\", \"youthful\", \"anti-aging\",\n                      \"anti aging\", \"older\", \"aged\", \"ageing\", \"aging\"]),\n        # aging (either direction) should not need to touch eyes or the nose bridge —\n        # keeping both protected is what keeps an aged/de-aged result recognisable\n        dict(parts=[\"forehead\", \"under_eye\", \"nasolabial\"], protect=[\"eye_aperture\", \"nose_core\"],\n             grow=0.08, blur=8, strength=0.44)),\n\n    (\"nose\", _rx([\"nose\", \"nasal\", \"rhinoplasty\", \"nose job\", \"nostril\", \"nostrils\",\n                  \"nose bridge\"]),\n        dict(parts=[\"nose\"], protect=[], grow=0.10, blur=6, strength=0.42)),\n\n    (\"slimming\", _rx([\"slim\", \"slimmer\", \"slimming\", \"thinner face\", \"jawline\", \"jaw line\",\n                      \"cheekbone\", \"cheekbones\", \"sculpt\", \"sculpted\", \"double chin\", \"chubby\",\n                      \"v-shape\", \"v shape\", \"face shape\", \"chiseled\"]),\n        dict(parts=[\"face_oval\"], protect=[\"eye_aperture\", \"nose_core\"],\n             grow=0.14, blur=10, strength=0.56, neck=True)),\n\n    (\"tan\", _rx([\"tan\", \"tanned\", \"sun-kissed\", \"sunkissed\", \"darker skin\", \"lighter skin\",\n                 \"glow\", \"glowy\", \"dewy\"]),\n        dict(parts=[\"face_oval\"], protect=[\"eye_aperture\"], grow=0.05, blur=9, strength=0.40)),\n]\n\nSPECIFIC_MAKEUP = {\"remove_makeup\", \"eye_makeup\", \"brows\", \"lips\"}\n\nDEFAULT_SPEC = dict(parts=[\"face_oval\"], protect=[\"eye_aperture\", \"nose_core\"],\n                    grow=0.08, blur=9, strength=0.44)\n\nUNSUPPORTED_RX = _rx([\"hair colour\", \"hair color\", \"hairstyle\", \"haircut\", \"hair\", \"background\",\n                      \"clothes\", \"clothing\", \"outfit\", \"shirt\", \"earring\", \"earrings\",\n                      \"necklace\", \"glasses\", \"hat\", \"teeth\", \"tooth\"])\n\n_SUBSUMED = {\"cheeks\", \"forehead\", \"lower_face\", \"jaw\", \"chin\", \"eyelids\", \"brows\", \"under_eye\",\n             \"nasolabial\"}\n\ndef resolve_intent(text):\n    \"\"\"free text -> (spec dict, matched rule names, warning str or '')\"\"\"\n    t = (text or \"\")\n    matched = [(name, spec) for name, rx, spec in INTENT_RULES if rx.search(t)]\n    names = [n for n, _ in matched]\n\n    if \"full_makeup\" in names and (set(names) & SPECIFIC_MAKEUP) and not WHOLE_FACE_CUES.search(t):\n        matched = [(n, s) for n, s in matched if n != \"full_makeup\"]\n        names = [n for n, _ in matched]\n\n    if not matched:\n        spec, rules = dict(DEFAULT_SPEC), [\"default_face\"]\n    else:\n        parts, protect = [], set()\n        strengths, grows, blurs, neck = [], [], [], False\n        for _, s in matched:\n            parts += s[\"parts\"]\n            protect |= set(s.get(\"protect\", []))          # UNION, not intersection\n            strengths.append(s[\"strength\"])\n            grows.append(s[\"grow\"]); blurs.append(s[\"blur\"])\n            neck = neck or bool(s.get(\"neck\", False))\n        parts = list(dict.fromkeys(parts))\n        if \"face_oval\" in parts:\n            parts = [\"face_oval\"] + [p for p in parts if p != \"face_oval\" and p not in _SUBSUMED]\n        protect -= set(parts)                              # never protect a targeted part\n        spec = dict(parts=parts, protect=sorted(protect),\n                    grow=float(np.mean(grows)), blur=int(round(np.mean(blurs))),\n                    strength=float(max(strengths)), neck=neck)\n        rules = names\n\n    m = UNSUPPORTED_RX.search(t)\n    warn = (f\"'{m.group(0)}' is outside the face mask, so that part of the request will have no \"\n            \"effect. Only facial regions are editable.\") if m else \"\"\n    return spec, rules, warn\n\ndef spec_summary(spec, rules):\n    return (f\"intent: {', '.join(rules)}\\nmask parts: {', '.join(spec['parts'])}\"\n            f\"\\nprotected: {', '.join(spec['protect']) or 'none'}\"\n            f\"\\nstrength: {spec['strength']:.2f}\")\n\nfor _p in [\"smokey eye makeup and red lipstick\", \"remove all her makeup\", \"add a thick beard\",\n           \"make the nose smaller\", \"soft glam makeup for a wedding\", \"an important portrait\",\n           \"change her hair color to blonde\", \"clear up the acne\", \"slimmer jawline\"]:\n    _s, _r, _w = resolve_intent(_p)\n    print(f\"  {_p:36s} -> {'+'.join(_r):26s} parts={_s['parts']} protect={_s['protect']}\")\n\nprint(\"Cell 3 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:07.905079Z","iopub.execute_input":"2026-08-20T07:21:07.905329Z","iopub.status.idle":"2026-08-20T07:21:07.934959Z","shell.execute_reply.started":"2026-08-20T07:21:07.905309Z","shell.execute_reply":"2026-08-20T07:21:07.934141Z"}},"outputs":[{"name":"stdout","text":"  smokey eye makeup and red lipstick   -> eye_makeup+lips            parts=['eyelids', 'brows', 'lips'] protect=['eye_aperture']\n  remove all her makeup                -> remove_makeup              parts=['face_oval'] protect=['eye_aperture']\n  add a thick beard                    -> beard                      parts=['lower_face', 'chin', 'jaw', 'nasolabial'] protect=['eye_aperture']\n  make the nose smaller                -> nose                       parts=['nose'] protect=[]\n  soft glam makeup for a wedding       -> full_makeup                parts=['face_oval'] protect=['eye_aperture']\n  an important portrait                -> default_face               parts=['face_oval'] protect=['eye_aperture', 'nose_core']\n  change her hair color to blonde      -> default_face               parts=['face_oval'] protect=['eye_aperture', 'nose_core']\n  clear up the acne                    -> skin                       parts=['face_oval'] protect=['eye_aperture', 'lips']\n  slimmer jawline                      -> slimming                   parts=['face_oval'] protect=['eye_aperture', 'nose_core']\nCell 3 complete\n","output_type":"stream"}],"execution_count":5},{"id":"633ba443-e8b0-4ad3-b62c-6b3a4c2477aa","cell_type":"markdown","source":"## 5 · Image model\n\n`render_pair()` renders both wordings from one mask and one seed, so only the prompt differs.","metadata":{}},{"id":"d5a94214-b03e-4632-b27f-5f539aba2edc","cell_type":"code","source":"# ── Cell 4 · Stable Diffusion inpaint pipeline + PAIRED render ─────────────\n#\n# ARCHITECTURAL CHANGE: no IP-Adapter, no LoRA, no reference images. Those were\n# in the old notebook to teach a surgery \"look\"; here they would be uncontrolled\n# variables sitting between the prompt and the output. The pipeline is now a\n# plain inpainter so that the prompt is the only thing that differs between arms.\n#\n# render_pair() enforces the experimental control: ONE mask, ONE seed, ONE\n# strength, ONE checkpoint, rendered twice with two prompts.\n\nfrom diffusers import StableDiffusionInpaintPipeline, EulerDiscreteScheduler\n\n_PIPE = None\n\ndef get_pipe():\n    global _PIPE\n    if _PIPE is not None: return _PIPE\n    print(\"loading\", RENDER[\"repo\"], \"...\")\n    p = StableDiffusionInpaintPipeline.from_pretrained(\n        RENDER[\"repo\"], torch_dtype=DTYPE, use_safetensors=True, safety_checker=None)\n    p.scheduler = EulerDiscreteScheduler.from_config(p.scheduler.config)\n    p.to(DEVICE)\n    if DEVICE == \"cuda\":\n        p.enable_attention_slicing()\n        try: p.enable_vae_tiling()\n        except Exception: pass\n    p.set_progress_bar_config(disable=True)\n    _PIPE = p\n    print(\"pipeline ready\")\n    return _PIPE\n\ndef _prep(src):\n    \"\"\"Square-resize for the UNet, remembering the original aspect.\"\"\"\n    S = RENDER[\"size\"]\n    return src.convert(\"RGB\").resize((S, S), Image.LANCZOS), src.size\n\ndef render_one(square_src, mask, positive, negative, strength, seed):\n    pipe = get_pipe()\n    g = torch.Generator(device=DEVICE).manual_seed(int(seed))\n    out = pipe(prompt=positive, negative_prompt=negative,\n               image=square_src, mask_image=mask,\n               strength=float(strength),\n               num_inference_steps=RENDER[\"steps\"],\n               guidance_scale=RENDER[\"guidance\"],\n               generator=g).images[0]\n    out = composite(square_src, out, mask)\n    out = texture_restore(square_src, out, mask, RENDER[\"texture_addback\"])\n    return out\n\ndef render_pair(src_img, mask, prompt_a, neg_a, prompt_b, neg_b, strength, seed):\n    \"\"\"Same source, same mask, same seed, same strength -> only the prompt differs.\"\"\"\n    square, orig_size = _prep(src_img)\n    m = mask.resize((RENDER[\"size\"], RENDER[\"size\"]), Image.BILINEAR)\n    t0 = time.time()\n    img_a = render_one(square, m, prompt_a, neg_a, strength, seed)\n    img_b = render_one(square, m, prompt_b, neg_b, strength, seed)\n    dt = round(time.time() - t0, 1)\n    return img_a.resize(orig_size, Image.LANCZOS), img_b.resize(orig_size, Image.LANCZOS), dt\n\nprint(\"Cell 4 complete  (pipeline loads lazily on first generation)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:07.935948Z","iopub.execute_input":"2026-08-20T07:21:07.936224Z","iopub.status.idle":"2026-08-20T07:21:14.208604Z","shell.execute_reply.started":"2026-08-20T07:21:07.936192Z","shell.execute_reply":"2026-08-20T07:21:14.207972Z"}},"outputs":[{"name":"stderr","text":"Flax classes are deprecated and will be removed in Diffusers v1.0.0. We recommend migrating to PyTorch classes or pinning your version of Diffusers.\nFlax classes are deprecated and will be removed in Diffusers v1.0.0. We recommend migrating to PyTorch classes or pinning your version of Diffusers.\n","output_type":"stream"},{"name":"stdout","text":"Cell 4 complete  (pipeline loads lazily on first generation)\n","output_type":"stream"}],"execution_count":6},{"id":"5d6d9b64-6d33-48da-bfde-8a867afce636","cell_type":"markdown","source":"## 6 · The rewriter\n\nAlways runs — every request is rewritten, both versions are shown, and you pick.\n\n**Check:** must print `PASS`. If it says FAIL, fix the `GEMINI_API_KEY` secret before continuing.","metadata":{}},{"id":"fce96e8a-76eb-4739-b8e1-5faff76c2429","cell_type":"code","source":"# ── Cell 5 · DSPy prompt rewriter ──────────────────────────────────────────\n#\n# WHAT THIS DOES\n# Turns the user's plain-English request into a prompt Stable Diffusion can\n# actually use. The task rules live in a DSPy Signature rather than a hand-written\n# prompt string, and a deterministic validator checks the output afterwards.\n#\n# BACKENDS, tried in order:\n#   1. Gemini via direct REST   — free tier, bypasses litellm entirely\n#   2. OpenAI via dspy.LM       — needs paid credit\n#   3. local Qwen 4-bit         — no key, no internet, slower\n#   4. rule-based               — always works, but arm B ≈ arm A\n#\n# Add your key under Add-ons -> Secrets as GEMINI_API_KEY (free, no card:\n# https://aistudio.google.com/apikey), or paste it into GEMINI_KEY below.\n\nimport dspy, requests, time\nfrom types import SimpleNamespace\n\nGEMINI_KEY = \"\"          # paste a key here, or leave blank to use the Kaggle secret\nif not GEMINI_KEY:\n    try:\n        from kaggle_secrets import UserSecretsClient\n        GEMINI_KEY = UserSecretsClient().get_secret(\"GEMINI_API_KEY\")\n    except Exception:\n        GEMINI_KEY = \"\"\n\nLM_OBJ, LM_BACKEND = None, \"none\"\n_GEMINI_BASE = \"https://generativelanguage.googleapis.com/v1beta\"\n_GEMINI_MODEL = None\n\n# ── backend 1 · Gemini REST ───────────────────────────────────────────────\n# dspy.LM/litellm rejects newer Gemini model names, and older ones have no free\n# quota. Talking to the REST endpoint directly avoids both problems, and the\n# probe below finds a model this key can actually call rather than guessing.\ndef _gemini_call(messages, max_tokens=2048):\n    sys_txt, contents = [], []\n    for m in messages:\n        role, text = m.get(\"role\"), (m.get(\"content\") or \"\")\n        if role == \"system\": sys_txt.append(text)\n        else: contents.append({\"role\": \"model\" if role == \"assistant\" else \"user\",\n                               \"parts\": [{\"text\": text}]})\n    body = {\"contents\": contents,\n            \"generationConfig\": {\"temperature\": 0.7, \"topP\": 0.9, \"maxOutputTokens\": max_tokens}}\n    if sys_txt: body[\"systemInstruction\"] = {\"parts\": [{\"text\": \"\\n\\n\".join(sys_txt)}]}\n    last = \"\"\n    for attempt in range(4):\n        r = requests.post(f\"{_GEMINI_BASE}/models/{_GEMINI_MODEL}:generateContent\",\n                          params={\"key\": GEMINI_KEY}, json=body, timeout=120)\n        if r.status_code == 200:\n            d = r.json()\n            try:\n                return \"\".join(p.get(\"text\",\"\") for p in d[\"candidates\"][0][\"content\"][\"parts\"])\n            except Exception:\n                return \"\"\n        last = f\"{r.status_code} {r.text[:150]}\"\n        if r.status_code in (429, 500, 502, 503):\n            time.sleep(5*(attempt+1)); continue\n        break\n    raise RuntimeError(f\"Gemini REST failed — {last}\")\n\nclass GeminiLM(dspy.BaseLM):\n    def __init__(self, model):\n        super().__init__(model=model)\n        self.model = model; self.model_type = \"chat\"\n        self.kwargs = {\"temperature\": 0.7, \"max_tokens\": 2048}; self.history = []\n    def __call__(self, prompt=None, messages=None, **kw):\n        txt = _gemini_call(messages or [{\"role\":\"user\",\"content\":prompt or \"\"}])\n        self.history.append({\"messages\": messages, \"outputs\":[txt]}); return [txt]\n    def forward(self, prompt=None, messages=None, **kw):\n        txt = _gemini_call(messages or [{\"role\":\"user\",\"content\":prompt or \"\"}])\n        return SimpleNamespace(\n            choices=[SimpleNamespace(message=SimpleNamespace(content=txt, tool_calls=None),\n                                     finish_reason=\"stop\")],\n            usage=SimpleNamespace(prompt_tokens=0, completion_tokens=0, total_tokens=0),\n            model=self.model)\n\nif GEMINI_KEY:\n    CANDIDATES = [\"gemini-3.1-flash-lite\",\"gemini-3.5-flash-lite\",\"gemini-flash-lite-latest\",\n                  \"gemini-3.5-flash\",\"gemini-3.6-flash\",\"gemini-flash-latest\",\n                  \"gemini-2.5-flash-lite\",\"gemini-2.5-flash\",\"gemini-2.0-flash\"]\n    body = {\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"Reply with OK\"}]}],\n            \"generationConfig\":{\"temperature\":0,\"maxOutputTokens\":2048}}\n    for m in CANDIDATES:\n        try:\n            r = requests.post(f\"{_GEMINI_BASE}/models/{m}:generateContent\",\n                              params={\"key\": GEMINI_KEY}, json=body, timeout=45)\n            if r.status_code != 200: continue\n            d = r.json()\n            txt = \"\".join(p.get(\"text\",\"\") for p in d[\"candidates\"][0][\"content\"][\"parts\"])\n            if txt.strip():\n                _GEMINI_MODEL = m\n                LM_OBJ, LM_BACKEND = GeminiLM(m), f\"gemini/{m}\"\n                print(f\"connected: {LM_BACKEND}\")\n                break\n        except Exception:\n            continue\n    if LM_OBJ is None: print(\"no Gemini model answered — trying other backends\")\n\n# ── backend 2 · OpenAI ────────────────────────────────────────────────────\nif LM_OBJ is None:\n    try:\n        key = os.environ.get(\"OPENAI_API_KEY\")\n        if not key:\n            from kaggle_secrets import UserSecretsClient\n            key = UserSecretsClient().get_secret(\"OPENAI_API_KEY\")\n            os.environ[\"OPENAI_API_KEY\"] = key\n        lm = dspy.LM(\"openai/gpt-4o-mini\", max_tokens=400, temperature=0.7)\n        lm(messages=[{\"role\":\"user\",\"content\":\"Reply with OK\"}])   # verify, don't assume\n        LM_OBJ, LM_BACKEND = lm, \"openai/gpt-4o-mini\"\n        print(\"connected: openai/gpt-4o-mini\")\n    except Exception as e:\n        print(\"openai unavailable:\", str(e)[:90])\n\n# ── backend 3 · local Qwen ────────────────────────────────────────────────\nUSE_LOCAL_LM = True\nif LM_OBJ is None and USE_LOCAL_LM:\n    try:\n        import subprocess, sys\n        subprocess.run([sys.executable,\"-m\",\"pip\",\"install\",\"-q\",\"bitsandbytes\"], check=False)\n        from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n        MID = \"Qwen/Qwen2.5-3B-Instruct\"\n        bnb = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_quant_type=\"nf4\",\n                                 bnb_4bit_use_double_quant=True,\n                                 bnb_4bit_compute_dtype=torch.float16)\n        _tok = AutoTokenizer.from_pretrained(MID)\n        _hf = AutoModelForCausalLM.from_pretrained(MID, quantization_config=bnb,\n                                                   device_map=\"auto\").eval()\n        _DEV = next(_hf.parameters()).device\n        class LocalHFLM(dspy.BaseLM):\n            def __init__(self):\n                super().__init__(model=MID); self.kwargs={\"temperature\":0.7,\"max_tokens\":400}\n            def _gen(self, messages):\n                enc = _tok.apply_chat_template(messages, add_generation_prompt=True,\n                                               return_tensors=\"pt\")\n                ids = (enc[\"input_ids\"] if isinstance(enc, dict) else enc).to(_DEV)\n                with torch.no_grad():\n                    out = _hf.generate(ids, max_new_tokens=400, do_sample=True,\n                                       temperature=0.7, top_p=0.9,\n                                       pad_token_id=_tok.eos_token_id)\n                return _tok.decode(out[0][ids.shape[-1]:], skip_special_tokens=True)\n            def forward(self, prompt=None, messages=None, **kw):\n                txt = self._gen(messages or [{\"role\":\"user\",\"content\":prompt}])\n                return SimpleNamespace(\n                    choices=[SimpleNamespace(message=SimpleNamespace(content=txt, tool_calls=None),\n                                             finish_reason=\"stop\")],\n                    usage=SimpleNamespace(prompt_tokens=0,completion_tokens=0,total_tokens=0),\n                    model=MID)\n        LM_OBJ, LM_BACKEND = LocalHFLM(), MID\n        print(\"connected:\", MID)\n    except Exception as e:\n        print(\"local model unavailable:\", str(e)[:90])\n\nif LM_OBJ is not None:\n    dspy.configure(lm=LM_OBJ)\nelse:\n    print(\"NO LM — rewrites will use the rule-based fallback (arm B ≈ arm A)\")\n\n# ── signature ─────────────────────────────────────────────────────────────\nclass RewriteEditPrompt(dspy.Signature):\n    \"\"\"Rewrite a user's face-edit request into a Stable Diffusion inpainting prompt.\n\nFORMAT (mandatory)\n  Comma-separated visual tags only. No sentences. No instruction verbs.\n  Stable Diffusion does not follow instructions; the text encoder embeds every\n  word as a visual concept, so words like \"ensure\", \"while\", \"maintain\" and\n  \"focus on\" become visual noise rather than directions.\n\nRULES\n  1. Never use 4k, 8k, hyperrealistic, hyperdetailed, masterpiece, ultra sharp,\n     RAW photo, best quality, award winning. These hype tags degrade skin realism.\n  2. Describe concrete visible things: colour, finish, placement, skin texture,\n     fine hairs, pores, and lighting. Not abstract quality claims.\n  3. Preserve the user's intent exactly. If the request REMOVES something, the\n     prompt must not contain any tag describing that thing. Describe the END\n     STATE instead: \"remove beard\" becomes \"clean shaven jaw, bare skin\".\n  4. Only describe what is inside the masked region listed in mask_parts.\n     Do not describe hair, clothing, background or accessories.\n  5. positive_prompt: 6 to 12 tags, under 40 words. Shorter is better.\n  6. negative_prompt: 4 to 8 tags naming the artefacts to avoid for THIS edit.\n\"\"\"\n    edit_request    = dspy.InputField(desc=\"what the user typed, verbatim\")\n    mask_parts      = dspy.InputField(desc=\"facial regions the edit may touch\")\n    positive_prompt = dspy.OutputField(desc=\"comma-separated visual tags only, no sentences\")\n    negative_prompt = dspy.OutputField(desc=\"comma-separated artefact tags only\")\n\n_REWRITER = dspy.ChainOfThought(RewriteEditPrompt)\n\n# ── validator ─────────────────────────────────────────────────────────────\nHYPE_RE  = re.compile(r\"\\b(4k|8k|hyper-?realistic|hyper-?detailed|masterpiece|ultra[- ]sharp|\"\n                      r\"raw photo|best quality|award[- ]winning|trending on artstation|octane)\\b\", re.I)\nPROSE_RE = re.compile(r\"\\b(ensure|ensuring|maintain|maintaining|while|preserving|focus on|\"\n                      r\"make sure|should|must|please|remember|keep the|in order to)\\b\", re.I)\nREMOVAL_RE = re.compile(r\"\\b(remove|without|no |get rid of|erase|clear|delete|shave|strip)\\b\", re.I)\nREMOVAL_TERMS = {\n    \"beard\": [\"beard\",\"stubble\",\"facial hair\",\"moustache\",\"mustache\",\"goatee\",\"hair strands\"],\n    \"makeup\": [\"lipstick\",\"eyeshadow\",\"eyeliner\",\"mascara\",\"blush\",\"makeup\",\"foundation\"],\n    \"acne\": [\"acne\",\"pimple\",\"blemish\",\"spot\"],\n    \"wrinkle\": [\"wrinkle\",\"fine line\",\"crow\",\"creases\"],\n}\n\ndef clean_prompt(s):\n    s = (s or \"\").strip()\n    s = re.sub(r\"^(here('s| is)[^:]*:|sure[,!.]?|output:|positive prompt:|prompt:)\\s*\", \"\", s, flags=re.I)\n    s = s.replace(\"\\n\", \", \").strip().strip(\".\").strip()\n    s = re.sub(r\"\\s*,\\s*\", \", \", s)\n    s = re.sub(r\"(,\\s*){2,}\", \", \", s)\n    return s.strip(\" ,\")\n\ndef validate_prompt(text, request):\n    flags = []\n    if not text: return [\"empty\"]\n    if HYPE_RE.search(text):  flags.append(\"hype\")\n    if PROSE_RE.search(text): flags.append(\"prose_verb\")\n    if text.count(\",\") < 3:   flags.append(\"too_few_tags\")\n    if len(text.split()) > 45: flags.append(\"too_long\")\n    if len([c for c in text if c in \".!?\"]) >= 2: flags.append(\"sentences\")\n    if REMOVAL_RE.search(request or \"\"):\n        low, req = text.lower(), (request or \"\").lower()\n        for _, terms in REMOVAL_TERMS.items():\n            if any(t in req for t in terms) and any(t in low for t in terms):\n                flags.append(\"contradiction\"); break\n    return flags\n\ndef repair_prompt(text):\n    return clean_prompt(PROSE_RE.sub(\"\", HYPE_RE.sub(\"\", text)))\n\nTEXTURE_TAGS = (\"natural skin pores, visible skin texture, soft even lighting, \"\n                \"photographic detail, not airbrushed\")\ndef rule_rewrite(request, parts):\n    return f\"{clean_prompt(request)}, {TEXTURE_TAGS}\", BASE_NEGATIVE\n\n# ── public API ────────────────────────────────────────────────────────────\n_REWRITE_CACHE, _FIRST_ERROR = {}, {}\n\ndef dspy_rewrite(request, parts, use_cache=True):\n    \"\"\"-> dict(positive, negative, source, flags, latency_s).\n    source: dspy | dspy_repaired | dspy_flagged | rule_fallback\"\"\"\n    request = (request or \"\").strip()\n    if not request:\n        return dict(positive=\"\", negative=\"\", source=\"empty\", flags=[\"empty\"], latency_s=0.0)\n    key = (request, \"|\".join(parts))\n    if use_cache and key in _REWRITE_CACHE:\n        out = dict(_REWRITE_CACHE[key]); out[\"source\"] += \"+cache\"; return out\n\n    t0 = time.time(); pos = neg = \"\"; source = \"rule_fallback\"; flags = []\n    if LM_OBJ is not None:\n        try:\n            # dspy.configure() binds the LM per-thread; Gradio handlers run in\n            # worker threads, so the LM must be bound explicitly at call time.\n            with dspy.context(lm=LM_OBJ):\n                pred = _REWRITER(edit_request=request, mask_parts=\", \".join(parts))\n            pos = clean_prompt(getattr(pred, \"positive_prompt\", \"\"))\n            neg = clean_prompt(getattr(pred, \"negative_prompt\", \"\"))\n            flags = validate_prompt(pos, request)\n            if pos and flags and set(flags) <= {\"hype\",\"prose_verb\"}:\n                pos = repair_prompt(pos); flags = validate_prompt(pos, request)\n                source = \"dspy_repaired\"\n            elif pos and not flags: source = \"dspy\"\n            elif pos: source = \"dspy_flagged\"\n        except Exception as e:\n            flags = [\"exception:\" + type(e).__name__]\n            if \"shown\" not in _FIRST_ERROR:\n                _FIRST_ERROR[\"shown\"] = True\n                print(\"\\n!! FIRST LM ERROR:\", type(e).__name__, str(e)[:300], \"\\n\")\n    if not pos:\n        pos, neg = rule_rewrite(request, parts)\n        source = \"rule_fallback\"; flags = flags or [\"lm_unavailable\"]\n    if not neg: neg = BASE_NEGATIVE\n    out = dict(positive=pos, negative=neg, source=source, flags=flags,\n               latency_s=round(time.time()-t0, 2))\n    if source.startswith(\"dspy\"):        # never cache a failure\n        _REWRITE_CACHE[key] = dict(out)\n    return out\n\ndef build_arm_a(request):\n    return f\"{clean_prompt(request)}, {IDENTITY_ANCHOR}\", BASE_NEGATIVE\ndef build_arm_b(rewrite):\n    return f\"{rewrite['positive']}, {IDENTITY_ANCHOR}\", rewrite[\"negative\"]\n\ndef selftest_lm():\n    r = dspy_rewrite(\"smokey eye makeup\", [\"eyelids\",\"brows\"], use_cache=False)\n    print(\"source :\", r[\"source\"]); print(\"flags  :\", r[\"flags\"] or \"none\")\n    print(\"prompt :\", r[\"positive\"][:220])\n    ok = r[\"source\"].startswith(\"dspy\")\n    print(\"\\n\" + (\"PASS — rewriting is live.\" if ok else\n                  \"FAIL — running on the rule-based fallback. Add a GEMINI_API_KEY secret.\"))\n    return ok\n\nprint(\"\\nbackend:\", LM_BACKEND)\nselftest_lm()\n\n# ══════════════════════════════════════════════════════════════════════════\n#  PUBLIC ENTRY POINT — always rewrites\n# ══════════════════════════════════════════════════════════════════════════\n#  Earlier versions routed: rewriting was applied only to requests that removed\n#  a discrete element, where the study measured a large gain, and skipped\n#  elsewhere. That was dropped. Applying an intervention only where it is known\n#  to win flatters it, and it makes the system behave differently for two edit\n#  categories out of fifteen for no reason a user can see.\n#\n#  Every request is rewritten. Both versions are rendered and shown, and the\n#  person chooses. Where the study found the rewrite decisively better it will\n#  usually win that choice; where it found no difference the choice costs\n#  nothing.\n\ndef smart_rewrite(request, parts, rules=None):\n    \"\"\"Rewrite every request. `rules` is accepted so callers can pass the matched\n    intent names; it is used only for messaging, never to gate the rewrite.\"\"\"\n    request = (request or \"\").strip()\n    if not request:\n        return dict(positive=\"\", negative=BASE_NEGATIVE, source=\"empty\",\n                    flags=[\"empty\"], note=\"\", latency_s=0.0)\n    rw = dspy_rewrite(request, parts)\n    rw[\"note\"] = \"Both versions are shown — pick whichever you prefer.\"\n    return rw\n\nprint(\"\\nCell 5 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:14.209563Z","iopub.execute_input":"2026-08-20T07:21:14.210292Z","iopub.status.idle":"2026-08-20T07:21:17.54153Z","shell.execute_reply.started":"2026-08-20T07:21:14.210268Z","shell.execute_reply":"2026-08-20T07:21:17.540874Z"}},"outputs":[{"name":"stdout","text":"connected: gemini/gemini-3.1-flash-lite\n\nbackend: gemini/gemini-3.1-flash-lite\nsource : dspy\nflags  : none\nprompt : charcoal eyeshadow, matte black pigment, blended gradient, dark smokey finish, defined eyebrows, groomed arch, soft edges, skin texture, natural pores\n\nPASS — rewriting is live.\n\nCell 5 complete\n","output_type":"stream"}],"execution_count":7},{"id":"e499f053-679a-4cbf-b720-738703bae7ea","cell_type":"markdown","source":"## 7 · Saving","metadata":{}},{"id":"0d4ab1b8-ab4e-428a-bf81-bb5e8a0717dc","cell_type":"code","source":"# ── Cell 6 · Dataset store (flat CSV + PNG tree) ───────────────────────────\n#\n# ARCHITECTURAL CHANGE: the old data_layer.py carried a SQLite schema plus an\n# optional Supabase mirror, with tables for human_score, skin_tone, lip_shade\n# and per-face iteration groups -- all of it shaped around the scored dataset\n# that has been removed. One CSV plus a PNG tree covers everything the new\n# study records, and it is portable: the annotation packs read the same files.\n\nPAIR_FIELDS = [\n    \"pair_id\", \"timestamp\", \"session\",\n    # source\n    \"source_path\", \"source_sha1\", \"source_w\", \"source_h\",\n    # request + prompts\n    \"edit_request\", \"prompt_a\", \"negative_a\", \"prompt_b\", \"negative_b\",\n    \"rewrite_source\", \"rewrite_flags\", \"rewrite_latency_s\",\n    # mask\n    \"mask_path\", \"mask_parts\", \"mask_protect\", \"mask_grow\", \"mask_blur\",\n    \"mask_neck\", \"mask_backend\", \"mask_coverage\", \"mask_mean\", \"intent_rules\",\n    # render settings\n    \"seed\", \"strength\", \"model_key\", \"model_repo\", \"steps\", \"guidance\", \"size\",\n    \"texture_addback\", \"identity_anchor\", \"lm_backend\", \"gen_time_s\",\n    # outputs\n    \"image_a\", \"image_b\",\n]\n\ndef _append_row(path, fields, row):\n    new = not os.path.exists(path)\n    with open(path, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n        w = csv.DictWriter(f, fieldnames=fields, extrasaction=\"ignore\")\n        if new: w.writeheader()\n        w.writerow(row)\n\ndef save_pair(src_img, mask, img_a, img_b, request, arm_a, arm_b, rewrite,\n              mask_info, intent_rules, seed, strength, gen_time, session=\"s1\"):\n    pid = uuid.uuid4().hex[:10]\n    d = IMG / pid; d.mkdir(parents=True, exist_ok=True)\n    p_src  = d / \"source.png\";  src_img.convert(\"RGB\").save(p_src)\n    p_mask = d / \"mask.png\";    mask.convert(\"L\").save(p_mask)\n    p_a    = d / \"arm_a.png\";   img_a.convert(\"RGB\").save(p_a)\n    p_b    = d / \"arm_b.png\";   img_b.convert(\"RGB\").save(p_b)\n\n    row = dict(\n        pair_id=pid, timestamp=now_iso(), session=session,\n        source_path=str(p_src), source_sha1=sha1_of(src_img),\n        source_w=src_img.size[0], source_h=src_img.size[1],\n        edit_request=request,\n        prompt_a=arm_a[0], negative_a=arm_a[1],\n        prompt_b=arm_b[0], negative_b=arm_b[1],\n        rewrite_source=rewrite[\"source\"], rewrite_flags=\"|\".join(rewrite[\"flags\"]),\n        rewrite_latency_s=rewrite[\"latency_s\"],\n        mask_path=str(p_mask), intent_rules=\"|\".join(intent_rules),\n        seed=int(seed), strength=round(float(strength), 3),\n        model_key=RENDER[\"model_key\"], model_repo=RENDER[\"repo\"],\n        steps=RENDER[\"steps\"], guidance=RENDER[\"guidance\"], size=RENDER[\"size\"],\n        texture_addback=RENDER[\"texture_addback\"], identity_anchor=IDENTITY_ANCHOR,\n        lm_backend=LM_BACKEND, gen_time_s=gen_time,\n        image_a=str(p_a), image_b=str(p_b),\n        **mask_info,\n    )\n    _append_row(PAIRS_CSV, PAIR_FIELDS, row)\n    return pid, row\n\ndef load_pairs():\n    if not os.path.exists(PAIRS_CSV):\n        return pd.DataFrame(columns=PAIR_FIELDS)\n    return pd.read_csv(PAIRS_CSV)\n\ndef store_summary():\n    df = load_pairs()\n    if df.empty: return \"no pairs recorded yet\"\n    src = df.rewrite_source.value_counts().to_dict()\n    return (f\"{len(df)} pairs | {df.source_sha1.nunique()} unique faces | \"\n            f\"{df.edit_request.nunique()} unique requests | rewrite source: {src}\")\n\nprint(\"store ready ->\", PAIRS_CSV)\nprint(store_summary())\nprint(\"Cell 6 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:17.542361Z","iopub.execute_input":"2026-08-20T07:21:17.542705Z","iopub.status.idle":"2026-08-20T07:21:17.55996Z","shell.execute_reply.started":"2026-08-20T07:21:17.542683Z","shell.execute_reply":"2026-08-20T07:21:17.559133Z"}},"outputs":[{"name":"stdout","text":"store ready -> /kaggle/working/vs_dspy/pairs.csv\nno pairs recorded yet\nCell 6 complete\n","output_type":"stream"}],"execution_count":8},{"id":"80ac8b52-a60d-4281-8911-424ff10d803d","cell_type":"markdown","source":"## 7b · Schema extension for the ablation study\n\nExtension cell — adds new functions only, nothing above is modified.","metadata":{}},{"id":"83733ca9-a2da-445e-9921-299b37ab1c3d","cell_type":"code","source":"# ── Cell 6b · Schema extension — coverage-optimization logging (extension) ──\n#\n# Additive only: PAIR_FIELDS and save_pair() (Cell 6) are untouched, so\n# load_pairs(), final_dataset.csv and every existing analysis of it keep\n# working exactly as before. This cell defines a superset field list and\n# save_pair_v2(), used by the System C/D/E path (Cell 11b), which calls\n# save_pair() first (so the row still lands in the original CSV/schema for\n# cross-system comparability) and then appends the extra controller fields to\n# a second file. _append_row() already tolerates extra/missing keys\n# (extrasaction=\"ignore\"), so old and new schemas can coexist.\n\nPAIR_FIELDS_V2 = PAIR_FIELDS + [\n    \"system_mode\",                          # A/B/C/D/E ablation condition\n    \"tier_low\", \"tier_high\",                # weighted-mask coverage by tier (Cell 2b)\n    \"identity_drift\",                       # bone-anchored drift, final accepted image\n    \"structure_drift\", \"surface_drift\",\n    \"iterations\",                           # renders the controller needed\n    \"accepted\",                             # did any attempt clear DRIFT_LIMIT\n    \"coverage_final\",                       # mask_coverage of the accepted attempt\n    \"grow_final\",                           # spec['grow'] of the accepted attempt\n]\nPAIRS_CSV_V2 = ROOT / \"final_dataset_v2.csv\"\n\ndef save_pair_v2(src_img, mask, img_a, img_b, request, arm_a, arm_b, rewrite,\n                 mask_info, intent_rules, seed, strength, gen_time, session=\"s1\",\n                 system_mode=\"B\", ctrl=None):\n    pid, row = save_pair(src_img, mask, img_a, img_b, request, arm_a, arm_b, rewrite,\n                         mask_info, intent_rules, seed, strength, gen_time, session)\n    row = dict(row, system_mode=system_mode,\n              tier_low=mask_info.get(\"tier_low\"), tier_high=mask_info.get(\"tier_high\"),\n              identity_drift=(ctrl or {}).get(\"identity_drift\"),\n              structure_drift=(ctrl or {}).get(\"structure\"),\n              surface_drift=(ctrl or {}).get(\"surface\"),\n              iterations=(ctrl or {}).get(\"iterations\", 1),\n              accepted=(ctrl or {}).get(\"accepted\", True),\n              coverage_final=(ctrl or {}).get(\"coverage_final\", mask_info.get(\"mask_coverage\")),\n              grow_final=(ctrl or {}).get(\"grow_final\", mask_info.get(\"mask_grow\")))\n    _append_row(PAIRS_CSV_V2, PAIR_FIELDS_V2, row)\n    return pid, row\n\ndef load_pairs_v2():\n    if not os.path.exists(PAIRS_CSV_V2):\n        return pd.DataFrame(columns=PAIR_FIELDS_V2)\n    return pd.read_csv(PAIRS_CSV_V2)\n\nprint(\"Cell 6b complete — save_pair_v2, load_pairs_v2 ->\", PAIRS_CSV_V2)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:17.561021Z","iopub.execute_input":"2026-08-20T07:21:17.561442Z","iopub.status.idle":"2026-08-20T07:21:17.592639Z","shell.execute_reply.started":"2026-08-20T07:21:17.561407Z","shell.execute_reply":"2026-08-20T07:21:17.592098Z"}},"outputs":[{"name":"stdout","text":"Cell 6b complete — save_pair_v2, load_pairs_v2 -> /kaggle/working/vs_dspy/final_dataset_v2.csv\n","output_type":"stream"}],"execution_count":9},{"id":"59ae9b18-66d0-4a7e-918c-3c59c4b2bb56","cell_type":"markdown","source":"## 8 · Batch requests","metadata":{}},{"id":"b5f2a3ab-a222-4bdb-b63a-ed42b9e6413c","cell_type":"code","source":"# ── Cell 7 · Prompt variation set + batch generation ───────────────────────\n#\n# WHY THE REGISTERS EXIST\n# A rewriter can only be shown to help where the input has headroom. If every\n# request is already a competent tag list, arm B has nothing to improve and the\n# study cannot detect an effect that has nowhere to appear. So each edit\n# category is written at four quality registers:\n#\n#   bare    one or two words                     -> maximum headroom\n#   prose   how a real user actually types        -> CLIP handles prose badly\n#   hype    8k / masterpiece / hyperrealistic     -> known to score ~1.5/5\n#   tagged  an already-good comma-separated list  -> CONTROL: no gain expected\n#\n# The \"tagged\" rows are not filler. If arm B beats them too, that is either a\n# real finding or a sign of annotator bias, and you want to see which.\n\nREGISTERS = [\"bare\", \"prose\", \"hype\", \"tagged\"]\n\nREQUEST_SET = {\n \"lipstick\":     [\"lipstick\",\n                  \"could you put a nice red lipstick on her please\",\n                  \"8k hyperrealistic masterpiece flawless glossy lipstick ultra detailed\",\n                  \"deep red matte lipstick, defined lip line, soft natural lip texture\"],\n \"eye_makeup\":   [\"smokey eye\",\n                  \"give her a smokey eye like she is going to a party\",\n                  \"8k hyperdetailed dramatic smokey eye masterpiece award winning\",\n                  \"blended charcoal eyeshadow, soft smudged liner, defined lashes, natural lid texture\"],\n \"full_makeup\":  [\"makeup\",\n                  \"can you do a soft glam makeup look for a wedding\",\n                  \"masterpiece flawless 8k full glam makeup ultra sharp perfect skin\",\n                  \"soft matte foundation, neutral eyeshadow, rosy blush, groomed brows, visible skin pores\"],\n \"remove_makeup\":[\"no makeup\",\n                  \"please remove all of her makeup so she looks natural\",\n                  \"8k hyperrealistic bare face no makeup masterpiece clean flawless\",\n                  \"bare face, no lipstick, no eyeshadow, no blush, natural pale lips, visible pores\"],\n \"beard_add\":    [\"beard\",\n                  \"add a full thick beard to him\",\n                  \"8k hyperdetailed masterpiece thick beard ultra sharp facial hair\",\n                  \"full dark beard, dense individual hair strands, natural growth pattern, matte skin\"],\n \"beard_remove\": [\"shave\",\n                  \"remove his beard completely so he is clean shaven\",\n                  \"hyperrealistic 8k clean shaven flawless masterpiece smooth\",\n                  \"clean shaven jaw, bare skin, faint shadow, natural skin pores, no facial hair\"],\n \"skin_acne\":    [\"clear skin\",\n                  \"can you clear up the acne on her face\",\n                  \"8k flawless perfect poreless skin masterpiece hyperrealistic\",\n                  \"clear even complexion, blemishes removed, natural skin pores retained, soft lighting\"],\n \"wrinkles\":     [\"younger\",\n                  \"make her look about ten years younger please\",\n                  \"8k hyperrealistic youthful flawless masterpiece anti aging perfect\",\n                  \"reduced fine lines, softened nasolabial folds, firm skin, natural pores, rested eyes\"],\n \"older\":        [\"older\",\n                  \"age him up so he looks like he is in his sixties\",\n                  \"8k hyperdetailed elderly masterpiece ultra realistic aged\",\n                  \"deep forehead lines, crows feet, softened jaw, thinner skin, age spots, natural texture\"],\n \"nose\":         [\"smaller nose\",\n                  \"make her nose a bit thinner and more refined\",\n                  \"masterpiece 8k perfect refined nose hyperrealistic ultra sharp\",\n                  \"narrower nasal bridge, refined tip, smaller nostrils, natural skin texture, even lighting\"],\n \"slimming\":     [\"slimmer face\",\n                  \"slim her face down and sharpen the jawline\",\n                  \"8k hyperrealistic chiseled sculpted jawline masterpiece perfect\",\n                  \"narrower cheeks, defined jawline, visible cheekbones, natural skin texture\"],\n \"brows\":        [\"eyebrows\",\n                  \"shape her eyebrows so they look neater\",\n                  \"8k perfect flawless eyebrows masterpiece hyperdetailed\",\n                  \"groomed arched brows, defined tail, individual brow hairs, natural skin\"],\n \"tan\":          [\"tan\",\n                  \"give her a sun kissed tanned glow\",\n                  \"8k hyperrealistic golden glowing tanned skin masterpiece flawless\",\n                  \"warm sun tanned skin, soft sheen, even tone, visible pores, natural lighting\"],\n \"freckles\":     [\"freckles\",\n                  \"add some light freckles across her nose and cheeks\",\n                  \"8k hyperdetailed perfect freckles masterpiece ultra sharp\",\n                  \"scattered light freckles, across nose bridge and cheeks, natural skin texture\"],\n \"dark_circles\": [\"dark circles\",\n                  \"get rid of the dark circles under his eyes\",\n                  \"8k flawless bright under eyes masterpiece hyperrealistic perfect\",\n                  \"brightened under-eye area, reduced shadowing, natural skin texture, rested look\"],\n}\n\nFLAT_REQUESTS = [(cat, REGISTERS[i], txt)\n                 for cat, lst in REQUEST_SET.items() for i, txt in enumerate(lst)]\n\n# ------------------------------------------------------------- face sourcing\ndef find_faces(patterns=None, limit=40, verbose=True):\n    \"\"\"Collect source photos with a detectable face from attached datasets.\"\"\"\n    pats = patterns or [\"/kaggle/input/**/*.jpg\", \"/kaggle/input/**/*.jpeg\",\n                        \"/kaggle/input/**/*.png\", \"/kaggle/working/faces/*.*\",\n                        str(ROOT / \"faces\" / \"*.*\")]\n    seen = []\n    for p in pats:\n        seen += glob.glob(p, recursive=True)\n    seen = sorted(set(seen))\n    keep = []\n    for f in seen:\n        try:\n            im = Image.open(f).convert(\"RGB\")\n            if min(im.size) < 256:\n                continue\n            pts, _ = get_landmarks(im)\n            if pts is not None and len(pts) > 200:\n                keep.append(f)\n        except Exception:\n            continue\n        if len(keep) >= limit:\n            break\n    if verbose:\n        print(f\"scanned {len(seen)} files, kept {len(keep)} with a detected face\")\n    return keep\n\ndef clear_batch():\n    \"\"\"Discard a contaminated run. batch_generate skips (face, request) pairs it\n    has already seen, so a re-run without this generates nothing.\"\"\"\n    import shutil\n    if os.path.exists(PAIRS_CSV):\n        shutil.move(str(PAIRS_CSV), str(ROOT / f\"pairs_discarded_{int(time.time())}.csv\"))\n    if IMG.exists(): shutil.rmtree(str(IMG))\n    IMG.mkdir(parents=True, exist_ok=True)\n    for f in PACKS.glob(\"pack_*.html\"): f.unlink()\n    _REWRITE_CACHE.clear()\n    print(\"cleared —\", store_summary())\n\n# ------------------------------------------------------------ batch driver\ndef batch_generate(faces, target_pairs=200, session=\"batch1\", seed0=20260808):\n    \"\"\"Generator yielding progress lines. Resumable: skips (face, request) pairs\n    already present in pairs.csv, so a dead session can just be rerun.\"\"\"\n    if not faces:\n        yield \"no source faces found — attach a face dataset or upload to /kaggle/working/faces/\"\n        return\n\n    done = set()\n    prev = load_pairs()\n    if not prev.empty:\n        done = set(zip(prev.source_sha1.astype(str), prev.edit_request.astype(str)))\n        yield f\"resuming — {len(done)} pairs already recorded\"\n\n    # Face must rotate EVERY pair. A face-major plan (face = faces[k // 60])\n    # spends the first 60 pairs on one face, so a 200-pair run touches only 4.\n    # Rotating by request index keeps register balance exact while spreading faces.\n    nF, nR = len(faces), len(FLAT_REQUESTS)\n    plan = []\n    for rnd in range(math.ceil(target_pairs / nR) + 3):\n        for i, (cat, reg, req) in enumerate(FLAT_REQUESTS):\n            plan.append((faces[(i + rnd * 7) % nF], req, cat, reg))\n\n    rng = random.Random(seed0)\n    made = skipped = failed = 0\n    t0 = time.time(); src_seen = set()\n    for face, req, cat, reg in plan:\n        if made >= target_pairs:\n            break\n        try:\n            src = Image.open(face).convert(\"RGB\")\n            h = sha1_of(src)\n            if (h, req) in done:\n                skipped += 1\n                continue\n            spec, rules, _ = resolve_intent(req)\n            mask, info = build_mask(src, spec)\n            if info[\"mask_backend\"] == \"haar_fallback\":\n                skipped += 1\n                continue                                   # no landmarks -> unusable row\n            rw = smart_rewrite(req, spec[\"parts\"], rules)\n            arm_a, arm_b = build_arm_a(req), build_arm_b(rw)\n            seed = rng.randint(0, 2**31 - 1)\n            ia, ib, dt = render_pair(src, mask, arm_a[0], arm_a[1],\n                                     arm_b[0], arm_b[1], spec[\"strength\"], seed)\n            save_pair(src, mask, ia, ib, req, arm_a, arm_b, rw, info,\n                      rules + [f\"register:{reg}\", f\"category:{cat}\"],\n                      seed, spec[\"strength\"], dt, session)\n            done.add((h, req)); made += 1\n            if made % 5 == 0 or made == 1:\n                el = time.time() - t0\n                eta = el/made*(target_pairs-made)/60\n\n        except Exception as e:\n            failed += 1\n            yield f\"FAIL {cat}/{reg}: {type(e).__name__}: {str(e)[:70]}\"\n            if failed > 15:\n                yield \"too many failures — stopping\"; break\n\n    yield f\"DONE — {made} pairs, {len(src_seen)} distinct faces, {skipped} skipped, {failed} failed\"\n    yield store_summary()\n\ndef run_batch(faces, target_pairs=200, session=\"batch1\"):\n    \"\"\"Blocking version for use directly in a notebook cell.\"\"\"\n    for line in batch_generate(faces, target_pairs, session):\n        print(line)\n\nFACES = find_faces(limit=40)\nprint(f\"{len(REQUEST_SET)} categories x {len(REGISTERS)} registers = {len(FLAT_REQUESTS)} requests\")\nprint(\"Cell 7 complete — use the Batch tab, or run: run_batch(FACES, 200)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:17.594972Z","iopub.execute_input":"2026-08-20T07:21:17.595426Z","iopub.status.idle":"2026-08-20T07:21:23.769895Z","shell.execute_reply.started":"2026-08-20T07:21:17.595404Z","shell.execute_reply":"2026-08-20T07:21:23.769277Z"}},"outputs":[{"name":"stdout","text":"scanned 2653 files, kept 40 with a detected face\n15 categories x 4 registers = 60 requests\nCell 7 complete — use the Batch tab, or run: run_batch(FACES, 200)\n","output_type":"stream"}],"execution_count":10},{"id":"e5de0854-063d-43f8-a459-b6ebc8b1ee9f","cell_type":"markdown","source":"## 9 · Prompt library from the scored dataset\n\nTwo uses for the 172 scored pairs:\n\n- **eight demonstrations** attached to the rewriter via `LabeledFewShot`, spread across categories\n  so it does not see eight variations of the same edit;\n- **a 45-entry suggestion library**, retrieved by request similarity and shown as a third option.\n\nRetrieval combines character trigrams with content-word overlap, so *\"make him clean shaven\"*\nmatches *\"remove his beard completely so he is clean shaven\"* despite sharing little surface text.\nNonsense input matches nothing.","metadata":{}},{"id":"52ef6012-0302-4cfc-bb2a-ba7615d873f7","cell_type":"code","source":"# ── Cell 8 · Prompt library mined from the human-scored dataset ────────────\n#\n# WHAT THIS DOES\n# The annotation study produced 172 scored pairs. Two kinds of row in it are\n# worth reusing:\n#\n# A first version of this cell kept a row if the rewrite improved a lot OR if it\n# scored well. That was wrong: the first clause admitted rows where the rewrite\n# beat something worse but was still poor in absolute terms, such as a beard edit\n# scoring 2.0 on realism and 2.0 on identity for a gain of +1.0. Eight of\n# forty-five entries had a score of 2 or below on some dimension.\n#\n# The filter now requires ABSOLUTE quality regardless of how much the rewrite\n# improved: every dimension at or above 3.5, and 12.0 across the three. A large\n# improvement over a bad baseline is not evidence of a good prompt.\n#\n# Those rows become two things:\n#\n#   1. DEMONSTRATIONS for DSPy. LabeledFewShot attaches them to the rewriter, so\n#      the model sees worked examples of the transformation before attempting\n#      its own. This is the actual optimisation step, driven by human labels.\n#\n#   2. A SUGGESTION LIBRARY. When the user's request resembles one already in\n#      the library, the stored prompt is offered as a third option alongside A\n#      and B. The rewriter still runs every time; this only adds a choice.\n#\n# Retrieval is character-trigram Jaccard similarity, which needs no embedding\n# model and no extra dependency, and is adequate for matching short edit\n# requests to a 45-entry library.\n\nimport glob, os, re, json\nimport pandas as pd\n\n# ---- locate the dataset -------------------------------------------------\n_cands = (glob.glob(\"/kaggle/input/**/final_dataset.csv\", recursive=True)\n          + ([str(FINAL_CSV)] if FINAL_CSV.exists() else []))\nLIBRARY, DEMOS = [], []\n\nif not _cands:\n    print(\"no final_dataset.csv found — the rewriter stays zero-shot, which is fine.\")\n    print(\"attach the dataset under + Add Data to enable demonstrations and suggestions.\")\nelse:\n    SRC = _cands[0]\n    print(\"reading\", SRC)\n    _d = pd.read_csv(SRC)\n    for c in (\"a_realism\",\"b_realism\",\"a_identity\",\"b_identity\",\"a_followed\",\"b_followed\"):\n        _d[c] = pd.to_numeric(_d[c], errors=\"coerce\")\n    _d[\"gain\"] = ((_d.b_realism - _d.a_realism) + (_d.b_identity - _d.a_identity)\n                  + (_d.b_followed - _d.a_followed))\n\n    _pp = _d.groupby(\"pair_id\").agg(\n        gain=(\"gain\",\"mean\"), bR=(\"b_realism\",\"mean\"), bI=(\"b_identity\",\"mean\"),\n        bC=(\"b_followed\",\"mean\"), raters=(\"annotator_id\",\"nunique\"),\n        req=(\"edit_request\",\"first\"), pb=(\"prompt_b\",\"first\"),\n        parts=(\"mask_parts\",\"first\"), cat=(\"category\",\"first\")).reset_index()\n    _pp[\"absolute\"] = _pp.bR + _pp.bI + _pp.bC\n\n    # absolute floor on every dimension — a rewrite has to be good, not merely\n    # better than something bad\n    QUALITY_FLOOR, TOTAL_FLOOR = 3.5, 12.0\n    _pp[\"worst\"] = _pp[[\"bR\",\"bI\",\"bC\"]].min(axis=1)\n    _keep = _pp[(_pp.worst >= QUALITY_FLOOR) & (_pp.absolute >= TOTAL_FLOOR)]\n    _keep = _keep.drop_duplicates(\"req\").sort_values(\"absolute\", ascending=False)\n    _dropped = len(_pp) - len(_keep)\n\n    def _strip_anchor(p):\n        return re.sub(r\",?\\s*\" + re.escape(IDENTITY_ANCHOR) + r\"\\s*$\", \"\", str(p)).strip(\" ,\")\n\n    for r in _keep.itertuples():\n        LIBRARY.append(dict(request=str(r.req), prompt=_strip_anchor(r.pb),\n                            parts=str(r.parts), category=str(r.cat),\n                            realism=round(r.bR,2), identity=round(r.bI,2),\n                            compliance=round(r.bC,2), gain=round(r.gain,2),\n                            raters=int(r.raters)))\n\n    print(f\"{len(LIBRARY)} library entries across {_keep.cat.nunique()} categories \"\n          f\"({_dropped} pairs did not clear the quality floor)\")\n    print(f\"  mean scores kept: realism {_keep.bR.mean():.2f}  identity {_keep.bI.mean():.2f} \"\n          f\" compliance {_keep.bC.mean():.2f}\")\n    print(\"  by category:\", _keep.cat.value_counts().to_dict())\n\n# ---- request similarity -------------------------------------------------\n# Two signals, combined by taking the larger. Character trigrams catch shared\n# phrasing; content-word overlap catches shared meaning when the phrasing\n# differs (\"make him clean shaven\" against \"remove his beard completely so he\n# is clean shaven\" shares few trigrams but the informative words align).\n# Neither needs an embedding model.\n\n_STOP = {\"a\",\"an\",\"the\",\"of\",\"to\",\"for\",\"her\",\"his\",\"him\",\"she\",\"he\",\"them\",\"they\",\"it\",\"is\",\n         \"are\",\"be\",\"so\",\"and\",\"or\",\"please\",\"can\",\"you\",\"make\",\"makes\",\"look\",\"looks\",\"give\",\n         \"add\",\"some\",\"very\",\"more\",\"little\",\"bit\",\"much\",\"that\",\"this\",\"with\",\"on\",\"in\",\"at\",\n         \"just\",\"would\",\"like\",\"want\",\"could\"}\n\ndef _words(s):\n    return {w for w in re.findall(r\"[a-z]+\", str(s).lower())\n            if w not in _STOP and len(w) > 2}\n\ndef _trigrams(s):\n    s = re.sub(r\"[^a-z ]\", \" \", str(s).lower())\n    s = re.sub(r\"\\s+\", \" \", s).strip()\n    return {s[i:i+3] for i in range(max(0, len(s)-2))}\n\n_LIB_IDX = [(_trigrams(e[\"request\"]), _words(e[\"request\"]), e) for e in LIBRARY]\n\ndef suggest_from_library(request, parts=None, min_sim=0.34):\n    \"\"\"Closest human-validated prompt for a request like this one, or None.\"\"\"\n    if not _LIB_IDX:\n        return None\n    q3, qw = _trigrams(request), _words(request)\n    if not q3:\n        return None\n    best_sim, best = 0.0, None\n    for t3, tw, e in _LIB_IDX:\n        jac  = len(q3 & t3) / len(q3 | t3) if (q3 | t3) else 0.0\n        wrd  = len(qw & tw) / len(qw) if qw else 0.0\n        sim  = max(jac, wrd)\n        if parts and e[\"parts\"].split(\"|\")[0] in list(parts):\n            sim += 0.05                       # nudge towards the matching region\n        if sim > best_sim:\n            best_sim, best = sim, e\n    if best is None or best_sim < min_sim:\n        return None\n    out = dict(best); out[\"similarity\"] = round(min(best_sim, 1.0), 3)\n    return out\n\n# ---- DSPy demonstrations ------------------------------------------------\n# Only the strongest entries become demonstrations. Feeding the model 45 examples\n# would blow up the context and dilute the signal; eight strong ones is what\n# LabeledFewShot is designed for.\nif LIBRARY:\n    import dspy\n    # Prefer pairs judged by two annotators. A straight 5/5/5 from one rater is\n    # weaker evidence than 4.5/5/5 from two, and perfect scores cluster in\n    # single-rater pairs precisely because one lenient annotator can award them.\n    _best = sorted(LIBRARY, key=lambda e: (-e[\"raters\"],\n                   -(e[\"realism\"] + e[\"identity\"] + e[\"compliance\"])))\n    _seen, _train = set(), []\n    for e in _best:\n        if e[\"category\"] in _seen:          # spread across categories, not 8 lipsticks\n            continue\n        _seen.add(e[\"category\"])\n        _train.append(dspy.Example(\n            edit_request=e[\"request\"],\n            mask_parts=e[\"parts\"].replace(\"|\", \", \"),\n            positive_prompt=e[\"prompt\"],\n            negative_prompt=BASE_NEGATIVE).with_inputs(\"edit_request\", \"mask_parts\"))\n        if len(_train) >= 8:\n            break\n    DEMOS = _train\n    try:\n        from dspy.teleprompt import LabeledFewShot\n        _REWRITER = LabeledFewShot(k=len(DEMOS)).compile(student=_REWRITER, trainset=DEMOS)\n        _REWRITE_CACHE.clear()\n        _mr = sum(1 for e in _best[:len(DEMOS)] if e[\"raters\"] > 1)\n        print(f\"\\nrewriter compiled with {len(DEMOS)} demonstrations \"\n              f\"({', '.join(sorted(_seen))})\")\n        print(f\"  all from pairs scoring >= {QUALITY_FLOOR} on every dimension\")\n    except Exception as e:\n        print(\"\\nLabeledFewShot unavailable:\", str(e)[:70])\n        try:\n            _REWRITER.predict.demos = DEMOS\n            _REWRITE_CACHE.clear()\n            print(f\"attached {len(DEMOS)} demonstrations directly\")\n        except Exception:\n            print(\"rewriter stays zero-shot\")\n\n# ---- check ---------------------------------------------------------------\nif LIBRARY:\n    print(\"\\nsuggestion retrieval check:\")\n    for _p in [\"remove all her makeup\", \"make him clean shaven\",\n               \"red lipstick please\", \"make her look much older\",\n               \"add freckles on the nose\"]:\n        _s = suggest_from_library(_p)\n        if _s:\n            print(f\"  {_p:32s} -> [{_s['category']}] sim={_s['similarity']:.2f} \"\n                  f\"scores {_s['realism']}/{_s['identity']}/{_s['compliance']}\")\n        else:\n            print(f\"  {_p:32s} -> no close match\")\nprint(\"\\nCell 8 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:23.77091Z","iopub.execute_input":"2026-08-20T07:21:23.771278Z","iopub.status.idle":"2026-08-20T07:21:24.515423Z","shell.execute_reply.started":"2026-08-20T07:21:23.771256Z","shell.execute_reply":"2026-08-20T07:21:24.514638Z"}},"outputs":[{"name":"stdout","text":"reading /kaggle/input/datasets/alivehues/vision-studio-full/final_dataset.csv\n31 library entries across 15 categories (141 pairs did not clear the quality floor)\n  mean scores kept: realism 4.60  identity 4.48  compliance 4.60\n  by category: {'brows': 4, 'lipstick': 3, 'older': 3, 'wrinkles': 3, 'nose': 2, 'beard_remove': 2, 'remove_makeup': 2, 'full_makeup': 2, 'freckles': 2, 'tan': 2, 'eye_makeup': 2, 'dark_circles': 1, 'slimming': 1, 'skin_acne': 1, 'beard_add': 1}\n\nrewriter compiled with 8 demonstrations (brows, eye_makeup, freckles, full_makeup, nose, older, slimming, wrinkles)\n  all from pairs scoring >= 3.5 on every dimension\n\nsuggestion retrieval check:\n  remove all her makeup            -> [remove_makeup] sim=1.00 scores 5.0/4.0/5.0\n  make him clean shaven            -> [beard_remove] sim=1.00 scores 5.0/4.0/5.0\n  red lipstick please              -> [lipstick] sim=1.00 scores 5.0/5.0/5.0\n  make her look much older         -> no close match\n  add freckles on the nose         -> [freckles] sim=1.00 scores 5.0/4.0/5.0\n\nCell 8 complete\n","output_type":"stream"}],"execution_count":11},{"id":"d9163123-f66c-415b-adc6-bf8f179b25f6","cell_type":"markdown","source":"## 10 · Age targeting\n\nIn the scored dataset, `older` reached **4.32 out of 5 on identity preservation** with 81.8% of\nresults rated clearly the same person — fourth of fifteen categories, against 2.93 for beard\naddition and 2.57 for makeup removal.\n\nThe reason is structural. Ageing after skeletal maturity is a change in skin and soft tissue —\nwrinkles, pigmentation, translucency, volume loss, tissue descent — all of which lie inside the\nface oval where the mask can reach, while the silhouette that carries most of the perceived\nidentity is copied from the source unchanged.\n\nAdult progression is therefore this system's strongest edit. Childhood to adulthood is not, and no\nprompt will fix it: that transition is craniofacial growth, and an inpainting mask cannot move an\noutline it does not cover. The system says so rather than producing a confident wrong answer.","metadata":{}},{"id":"9b8d7803-8691-4404-85b8-93e89a1dc792","cell_type":"code","source":"# ── Cell 9 · Age targeting ─────────────────────────────────────────────────\n#\n# WHY AGEING IS THIS SYSTEM'S STRONGEST EDIT\n# In the annotation study, `older` scored 4.32 out of 5 on identity preservation\n# with 81.8% of results rated \"clearly the same person\" — fourth of fifteen edit\n# categories, against 2.93 for beard addition and 2.57 for makeup removal.\n#\n# The reason is structural. Ageing after skeletal maturity is a change in skin\n# and soft tissue: wrinkles, pigmentation, translucency, volume loss, tissue\n# descent. All of that lies inside the face oval, so the mask can reach it while\n# the silhouette, which carries most of the perceived identity, is copied\n# unchanged from the source. A beard, by contrast, occupies a quarter of the\n# frame and redraws the jaw outline.\n#\n# WHAT THIS MEANS FOR SCOPE\n# Adult progression, roughly 25 upward, is well supported. Childhood to\n# adulthood is not, and no prompt will fix it: that transition is craniofacial\n# growth, the skull lengthens and the jaw develops, and an inpainting mask\n# cannot move an outline it does not cover. The system reports this rather than\n# producing a confident wrong answer.\n\nAGE_RX   = re.compile(r\"\\b(\\d{2})\\s*(?:years?\\s*old|yo|y/o)\\b|\\bage[d]?\\s*(\\d{2})\\b|\"\n                      r\"\\bat\\s*(\\d{2})\\b|\\bin\\s*(?:his|her|their)\\s*(\\d{2})s\\b|\"\n                      r\"\\b(?:make|turn|show|age)\\s+(?:him|her|them|this\\s+\\w+)?\\s*(\\d{2})\\b\", re.I)\nDECADE_RX = re.compile(r\"\\b(twenties|thirties|forties|fifties|sixties|seventies|\"\n                       r\"eighties|nineties)\\b\", re.I)\n_DECADE = dict(twenties=25, thirties=35, forties=45, fifties=55,\n               sixties=65, seventies=75, eighties=85, nineties=92)\n\nAGE_UP_RX   = re.compile(r\"\\b(older|aged|ageing|aging|elderly|senior|age (?:him|her|them|up)|\"\n                         r\"years older|old man|old woman|grey haired|gray haired)\\b\", re.I)\nAGE_DOWN_RX = re.compile(r\"\\b(younger|youthful|de-?age|de-?aging|anti-?aging|anti-?ageing|\"\n                         r\"rejuvenate|years younger|look young|youth)\\b\", re.I)\nCHILD_RX    = re.compile(r\"\\b(child|children|kid|kids|baby|toddler|infant|little (?:boy|girl)|\"\n                         r\"childhood|young (?:boy|girl)|teenager|teen)\\b\", re.I)\n# \"what would this child look like as an adult\" carries no age word and no\n# number, but it is exactly the request the system must decline clearly.\nGROWN_RX    = re.compile(r\"\\b(as an adult|grown up|grown-up|when (?:he|she|they) grows?|\"\n                         r\"all grown|adulthood|in the future)\\b\", re.I)\n\ndef target_age(text):\n    \"\"\"Extract an explicit target age from the request, or None.\"\"\"\n    m = AGE_RX.search(str(text))\n    if m:\n        v = next(g for g in m.groups() if g)\n        v = int(v)\n        if 18 <= v <= 99:\n            return v\n    m = DECADE_RX.search(str(text))\n    if m:\n        return _DECADE[m.group(1).lower()]\n    return None\n\n# Ageing is a whole-face change, so it uses the full oval and protects only the\n# eye aperture. Strength rises with the size of the jump, because a 30-year\n# progression needs more denoising than a 10-year one.\nAGE_UP_SPEC   = dict(parts=[\"face_oval\"], protect=[\"eye_aperture\"],\n                     grow=0.06, blur=9, strength=0.50)\nAGE_DOWN_SPEC = dict(parts=[\"face_oval\"], protect=[\"eye_aperture\"],\n                     grow=0.06, blur=9, strength=0.48)\n\n# Vocabulary per decade band. Written from the prompts that scored 5/5/5 on the\n# `older` category in the study, which is why they name specific, locatable\n# features rather than the abstract idea of age.\nAGE_VOCAB = {\n    30: \"faint expression lines, slight loss of youthful plumpness, even skin tone, \"\n        \"fine pores, healthy matte skin\",\n    40: \"visible forehead lines, early crow's feet, faint nasolabial folds, \"\n        \"slightly reduced cheek volume, uneven pigmentation, natural pores\",\n    50: \"defined forehead lines, crow's feet, nasolabial folds, softening jawline, \"\n        \"under-eye hollowing, scattered age spots, drier skin texture\",\n    60: \"deep horizontal forehead wrinkles, prominent crow's feet, marked nasolabial \"\n        \"folds, sagging jawline, under-eye bags, hyperpigmentation, thinning skin\",\n    70: \"deep set wrinkles across forehead and cheeks, heavy crow's feet, jowls, \"\n        \"hollow cheeks, thin translucent skin, prominent age spots, sparse grey brows\",\n    85: \"deeply lined weathered skin, heavy jowls, sunken cheeks, hooded eyelids, \"\n        \"translucent papery skin, dense age spots, sparse white brows, visible veins\",\n}\n\ndef age_vocabulary(age):\n    \"\"\"Nearest band of ageing vocabulary for a target age.\"\"\"\n    return AGE_VOCAB[min(AGE_VOCAB, key=lambda k: abs(k - int(age)))]\n\ndef age_strength(from_age, to_age):\n    \"\"\"More denoising for a larger jump, capped where quality degrades.\n    The study found every outcome worse above 0.50, so 0.58 is the ceiling and\n    is reached only for progressions beyond forty years.\"\"\"\n    gap = abs(int(to_age) - int(from_age))\n    return round(min(0.58, 0.44 + 0.0035 * gap), 3)\n\n# ---- register the intents ----------------------------------------------\n# Inserted at the front so an age request is never captured by `skin` or `tan`,\n# which also match on complexion vocabulary.\nINTENT_RULES.insert(0, (\"age_down\", AGE_DOWN_RX, AGE_DOWN_SPEC))\nINTENT_RULES.insert(0, (\"age_up\",   AGE_UP_RX,   AGE_UP_SPEC))\n\n# The wrinkle rule keeps its three narrow strips, which is right for a targeted\n# repair such as \"remove her forehead lines\" but wrong for a whole-face age\n# change. Its age words are removed so they are no longer captured there.\n_WRINKLE_ONLY = _rx([\"wrinkle\", \"wrinkles\", \"botox\", \"fine lines\", \"smile lines\",\n                     \"crows feet\", \"crow's feet\", \"forehead lines\", \"laugh lines\",\n                     \"creases\", \"furrows\"])\nINTENT_RULES[:] = [(_n, _WRINKLE_ONLY if _n == \"wrinkles\" else _r, _sp)\n                   for _n, _r, _sp in INTENT_RULES]\n\ndef resolve_age_request(request, assumed_current=30):\n    \"\"\"-> dict or None. Adds the vocabulary and strength an age request needs.\"\"\"\n    t = str(request or \"\")\n    up, down = bool(AGE_UP_RX.search(t)), bool(AGE_DOWN_RX.search(t))\n    tgt   = target_age(t)\n    child = bool(CHILD_RX.search(t))\n    grown = bool(GROWN_RX.search(t))\n    if not (up or down or tgt or (child and grown)):\n        return None\n    if child and grown and not (up or down or tgt):\n        up, tgt = True, 30              # \"as an adult\" means adult, not elderly\n    if tgt is None:\n        tgt = 65 if up else 22\n    warn = \"\"\n    if CHILD_RX.search(t) or tgt < 18:\n        warn = (\"Childhood faces are outside what this system can do. Growing a child's \"\n                \"face into an adult's changes the skull and jaw, and the mask only \"\n                \"covers skin inside the face outline. Adult progression, roughly 25 \"\n                \"upward, is supported.\")\n    return dict(target=int(tgt), direction=\"up\" if tgt >= assumed_current else \"down\",\n                vocabulary=age_vocabulary(tgt),\n                strength=age_strength(assumed_current, tgt), warning=warn)\n\nprint(\"age targeting ready\")\nfor _p in [\"make her look 65 years old\", \"age him into his eighties\",\n           \"make her look ten years younger\", \"show him at 45\",\n           \"what would this child look like as an adult\", \"remove her forehead lines\"]:\n    _a = resolve_age_request(_p)\n    if _a:\n        print(f\"  {_p:46s} -> age {_a['target']}, strength {_a['strength']:.2f}\"\n              + (\"  [WARN]\" if _a[\"warning\"] else \"\"))\n    else:\n        print(f\"  {_p:46s} -> not an age request\")\nprint(\"\\nCell 9 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:24.516602Z","iopub.execute_input":"2026-08-20T07:21:24.516976Z","iopub.status.idle":"2026-08-20T07:21:24.535629Z","shell.execute_reply.started":"2026-08-20T07:21:24.516948Z","shell.execute_reply":"2026-08-20T07:21:24.534964Z"}},"outputs":[{"name":"stdout","text":"age targeting ready\n  make her look 65 years old                     -> age 65, strength 0.56\n  age him into his eighties                      -> age 85, strength 0.58\n  make her look ten years younger                -> age 22, strength 0.47\n  show him at 45                                 -> age 45, strength 0.49\n  what would this child look like as an adult    -> age 30, strength 0.44  [WARN]\n  remove her forehead lines                      -> not an age request\n\nCell 9 complete\n","output_type":"stream"}],"execution_count":12},{"id":"2bf53df1-42f3-47ef-a1e3-ee737c4c81ad","cell_type":"markdown","source":"## 11 · Identity guard, age-aware\n\nThe guard has to allow ageing while still catching an identity swap, and those pull in opposite\ndirections. The resolution is to split the landmarks by what drives them:\n\n| group | landmarks | behaviour |\n|---|---|---|\n| **bone-anchored** | eye corners, interocular span, nose bridge, glabella | fixed after skeletal maturity — **enforced** |\n| **soft-tissue** | mouth, chin, cheeks, temples, jaw contour | changes with age — **reported only** |\n\nVerified against synthetic deformations: simulated ageing (tissue descent plus cheek hollowing)\nproduces **0.000** drift on the bone-anchored set, while a simulated identity substitution produces\n**0.272**. The guard permits the first and catches the second.","metadata":{}},{"id":"c52b7347-cddb-4b39-83c6-89b3f929c694","cell_type":"code","source":"# ── Cell 10 · Identity guard, age-aware ────────────────────────────────────\n#\n# THE PROBLEM THIS SOLVES\n# An identity guard that measures overall facial geometry will fight an ageing\n# edit, because ageing legitimately moves the face: tissue descends, cheeks\n# hollow, the jawline softens. A guard that blocks all geometric change also\n# blocks the edit we most want to make.\n#\n# THE SPLIT\n# Facial landmarks divide into two groups by what drives them.\n#\n#   BONE-ANCHORED   eye corners, interocular span, nose bridge, glabella.\n#                   Set by the skull, essentially fixed after skeletal maturity.\n#                   These carry identity and must not move.\n#\n#   SOFT-TISSUE     mouth corners, chin, cheek width, temple width, jaw contour.\n#                   Governed by fat volume, muscle tone and skin elasticity, all\n#                   of which change with age. These are allowed to move.\n#\n# The guard measures drift on the bone-anchored set only. Verified against\n# synthetic deformations: a simulated ageing change (tissue descent plus cheek\n# hollowing) produces 0.000 drift on the bone-anchored set, while a simulated\n# identity substitution produces 0.272. The guard therefore permits ageing and\n# still catches a face becoming somebody else.\n#\n# All distances are divided by the interocular span, so the measure is invariant\n# to image scale and to where the face sits in the frame. It measures a change\n# in facial proportion, not a change in framing.\n\nimport itertools\nimport numpy as np\nfrom PIL import Image\n\n# bone-anchored: eye corners, nose bridge, glabella\nID_STABLE  = [33, 133, 263, 362, 1, 168, 4, 6, 197]\n# soft-tissue: mouth, chin, cheeks, temples — reported, never enforced\nID_VARYING = [61, 291, 10, 152, 234, 454, 127, 356]\n\ndef _signature(pts, idx):\n    \"\"\"Interocular-normalised pairwise distances among the chosen landmarks.\"\"\"\n    P = pts[[i for i in idx if i < len(pts)]]\n    iod = np.linalg.norm(pts[33] - pts[263]) or 1.0\n    return np.array([np.linalg.norm(P[i] - P[j]) / iod\n                     for i, j in itertools.combinations(range(len(P)), 2)])\n\ndef face_geometry(pil):\n    \"\"\"(bone-anchored signature, soft-tissue signature) or (None, None).\"\"\"\n    pts, _ = get_landmarks(pil)\n    if pts is None or len(pts) < 468:\n        return None, None\n    return _signature(pts, ID_STABLE), _signature(pts, ID_VARYING)\n\ndef identity_drift(src, out, age_aware=True):\n    \"\"\"RMS proportional change in facial geometry.\n\n    age_aware=True  measures bone-anchored landmarks only, so ageing passes.\n    age_aware=False measures soft tissue too, appropriate for edits that should\n                    not move the face at all, such as lipstick or eye makeup.\"\"\"\n    a_s, a_v = face_geometry(src)\n    b_s, b_v = face_geometry(out)\n    if a_s is None or b_s is None:\n        return np.nan\n    stable = float(np.linalg.norm(a_s - b_s) / np.sqrt(len(a_s)))\n    if age_aware:\n        return stable\n    soft = float(np.linalg.norm(a_v - b_v) / np.sqrt(len(a_v)))\n    return max(stable, soft)\n\ndef drift_report(src, out):\n    \"\"\"Both numbers, for display. Soft-tissue movement during an ageing edit is\n    the edit working, not a fault, so it is shown rather than acted on.\"\"\"\n    a_s, a_v = face_geometry(src)\n    b_s, b_v = face_geometry(out)\n    if a_s is None or b_s is None:\n        return dict(structure=None, surface=None)\n    return dict(structure=round(float(np.linalg.norm(a_s-b_s)/np.sqrt(len(a_s))), 4),\n                surface=round(float(np.linalg.norm(a_v-b_v)/np.sqrt(len(a_v))), 4))\n\n# Threshold on the bone-anchored measure. A face whose skeletal proportions have\n# moved this far is no longer reliably the same person. Calibrate against your\n# own identity ratings with calibrate_drift_limit() once new scores are in.\nDRIFT_LIMIT = 0.020\n\ndef coverage_risk(coverage):\n    \"\"\"Identity risk from mask coverage. In the study, identity correlated with\n    coverage at rho = -0.427 and with denoising strength at only -0.148, so the\n    warning is driven by how much of the face is being regenerated.\"\"\"\n    if coverage > 0.34:\n        return \"high\", (\"Large edit area. A whole-face change needs this, but expect \"\n                        \"the face to shift a little.\")\n    if coverage > 0.26:\n        return \"moderate\", \"Fairly large edit area — some movement is normal here.\"\n    return \"low\", \"\"\n\ndef render_guarded(src, mask, positive, negative, strength, seed,\n                   age_aware=True, max_retries=2, step=0.08, verbose=False):\n    \"\"\"Render, measure structural drift, retry at lower strength if it exceeds\n    the limit. Returns (image, info).\"\"\"\n    square, orig_size = _prep(src)\n    m = mask.resize((RENDER[\"size\"], RENDER[\"size\"]), Image.BILINEAR)\n    attempts, s = [], float(strength)\n\n    for k in range(max_retries + 1):\n        out = render_one(square, m, positive, negative, s, seed)\n        big = out.resize(orig_size, Image.LANCZOS)\n        d = identity_drift(src, big, age_aware=age_aware)\n        attempts.append((s, d, big))\n        if verbose:\n            print(f\"    attempt {k+1}: strength {s:.2f}  structure drift {d:.4f}\")\n        if not (d == d) or d <= DRIFT_LIMIT:      # NaN means no landmarks found\n            break\n        s = max(0.20, s - step)\n        if k == max_retries:\n            break\n\n    valid = [(a, b, c) for a, b, c in attempts if b == b]\n    s_use, d_use, img = (min(valid, key=lambda t: t[1]) if valid else attempts[-1])\n    rep = drift_report(src, img)\n    return img, dict(strength_used=round(s_use, 3),\n                     identity_drift=None if d_use != d_use else round(d_use, 4),\n                     structure=rep[\"structure\"], surface=rep[\"surface\"],\n                     attempts=len(attempts), guard_fired=len(attempts) > 1,\n                     age_aware=age_aware)\n\ndef calibrate_drift_limit():\n    \"\"\"Set DRIFT_LIMIT from human identity ratings, once new scores are in.\"\"\"\n    import pandas as pd, glob\n    hits = glob.glob(\"/kaggle/input/**/identity_metrics.csv\", recursive=True)\n    p = hits[0] if hits else str(ROOT / \"identity_metrics.csv\")\n    if not os.path.exists(p):\n        print(\"no identity_metrics.csv — keeping the default\", DRIFT_LIMIT); return DRIFT_LIMIT\n    idm = pd.read_csv(p); fin = pd.read_csv(FINAL_CSV)\n    for c in (\"a_identity\", \"b_identity\"):\n        fin[c] = pd.to_numeric(fin[c], errors=\"coerce\")\n    long = pd.concat([fin[[\"pair_id\"]].assign(arm=\"A\", h=fin.a_identity),\n                      fin[[\"pair_id\"]].assign(arm=\"B\", h=fin.b_identity)])\n    lvl = long.groupby([\"pair_id\",\"arm\"]).h.mean().reset_index().merge(idm, on=[\"pair_id\",\"arm\"])\n    good, bad = lvl[lvl.h >= 4].geom_drift.dropna(), lvl[lvl.h <= 2].geom_drift.dropna()\n    if len(good) < 10 or len(bad) < 10:\n        print(f\"too few extremes (good={len(good)}, bad={len(bad)})\"); return DRIFT_LIMIT\n    best, acc = DRIFT_LIMIT, 0\n    for t in np.linspace(min(good.min(), bad.min()), max(good.max(), bad.max()), 200):\n        a = ((good <= t).sum() + (bad > t).sum()) / (len(good) + len(bad))\n        if a > acc: best, acc = t, a\n    print(f\"threshold {best:.4f} separates {acc:.1%} correctly\")\n    if acc < 0.65:\n        print(\"  weak separation — treat the guard as a warning, not a gate\")\n    return float(best)\n\nprint(\"identity guard ready\")\nprint(f\"  bone-anchored landmarks : {len(ID_STABLE)} points, {len(ID_STABLE)*(len(ID_STABLE)-1)//2} distances  [enforced]\")\nprint(f\"  soft-tissue landmarks   : {len(ID_VARYING)} points, {len(ID_VARYING)*(len(ID_VARYING)-1)//2} distances  [reported only]\")\nprint(f\"  structural drift limit  : {DRIFT_LIMIT}\")\nprint(\"\\nCell 10 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:24.53685Z","iopub.execute_input":"2026-08-20T07:21:24.537224Z","iopub.status.idle":"2026-08-20T07:21:24.561654Z","shell.execute_reply.started":"2026-08-20T07:21:24.537188Z","shell.execute_reply":"2026-08-20T07:21:24.560552Z"}},"outputs":[{"name":"stdout","text":"identity guard ready\n  bone-anchored landmarks : 9 points, 36 distances  [enforced]\n  soft-tissue landmarks   : 8 points, 28 distances  [reported only]\n  structural drift limit  : 0.02\n\nCell 10 complete\n","output_type":"stream"}],"execution_count":13},{"id":"546769df-e9a5-4f0d-a579-4027d41dc67b","cell_type":"markdown","source":"## 11b · Coverage-aware closed-loop controller\n\nExtension cell — adds new functions only, nothing above is modified.","metadata":{}},{"id":"c94483a9-c718-4dfe-9e45-f957de26d261","cell_type":"code","source":"# ── Cell 10b · Coverage-aware closed-loop controller (extension) ───────────\n#\n# render_guarded() (Cell 10) is untouched — System B keeps using it exactly\n# as today. This cell adds render_guarded_adaptive() for System D/E: on a\n# drift breach it alternates SHRINKING MASK COVERAGE (shrink_spec, Cell 2b)\n# with lowering diffusion strength, instead of only ever lowering strength.\n#\n# WHY COVERAGE FIRST\n# In the annotation study, identity correlated with mask coverage at\n# rho = -0.427 and with denoising strength at only rho = -0.148 — coverage is\n# the stronger predictor of identity loss, so the controller spends its first\n# retry there rather than on strength, and alternates thereafter.\n#\n# STOPPING CONDITIONS (bounded, per the brief: no infinite regeneration)\n#   * max_retries caps total attempts (default 3 retries = 4 renders)\n#   * grow floors at shrink_spec's min_grow (-0.10 by default)\n#   * strength floors at 0.20\n#   * first attempt at/under DRIFT_LIMIT is accepted immediately\n\ndef render_guarded_adaptive(src, spec, positive, negative, strength, seed,\n                            age_aware=True, max_retries=3, strength_step=0.08,\n                            coverage_step=0.06, verbose=False):\n    \"\"\"Render, measure structural drift, and — unlike render_guarded() — retry\n    by shrinking mask coverage as well as strength. Returns (image, info).\"\"\"\n    square, orig_size = _prep(src)\n    cur_spec = dict(spec)\n    s = float(strength)\n    attempts = []\n\n    for k in range(max_retries + 1):\n        mask, minfo = build_mask_tiered(src, cur_spec)\n        m = mask.resize((RENDER[\"size\"], RENDER[\"size\"]), Image.BILINEAR)\n        out = render_one(square, m, positive, negative, s, seed)\n        big = out.resize(orig_size, Image.LANCZOS)\n        d = identity_drift(src, big, age_aware=age_aware)\n        attempts.append((s, dict(cur_spec), d, big, minfo))\n        if verbose:\n            cov = minfo[\"mask_coverage\"]\n            print(f\"    attempt {k+1}: strength {s:.2f}  coverage {cov:.3f}  drift {d}\")\n        if not (d == d) or d <= DRIFT_LIMIT:      # NaN means no landmarks found\n            break\n        if k == max_retries:\n            break\n        # coverage first (stronger identity predictor in the study), then strength\n        if k % 2 == 0:\n            cur_spec = shrink_spec(cur_spec, step=coverage_step)\n        else:\n            s = max(0.20, s - strength_step)\n\n    valid = [(s_, sp_, d_, img_, mi_) for s_, sp_, d_, img_, mi_ in attempts if d_ == d_]\n    s_use, spec_use, d_use, img, minfo_use = (\n        min(valid, key=lambda t: t[2]) if valid else attempts[-1])\n    rep = drift_report(src, img)\n    return img, dict(\n        strength_used=round(s_use, 3),\n        identity_drift=None if d_use != d_use else round(d_use, 4),\n        structure=rep[\"structure\"], surface=rep[\"surface\"],\n        iterations=len(attempts), accepted=bool(valid),\n        guard_fired=len(attempts) > 1, age_aware=age_aware,\n        coverage_final=minfo_use[\"mask_coverage\"],\n        grow_final=spec_use.get(\"grow\"),\n    )\n\nprint(\"Cell 10b complete — render_guarded_adaptive\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:24.562667Z","iopub.execute_input":"2026-08-20T07:21:24.563028Z","iopub.status.idle":"2026-08-20T07:21:24.580723Z","shell.execute_reply.started":"2026-08-20T07:21:24.562996Z","shell.execute_reply":"2026-08-20T07:21:24.579952Z"}},"outputs":[{"name":"stdout","text":"Cell 10b complete — render_guarded_adaptive\n","output_type":"stream"}],"execution_count":14},{"id":"e1abc40d-2279-4d91-8feb-23657b89d78d","cell_type":"markdown","source":"## 12 · Interface handlers\n\nBoth prompts type themselves out as a typewriter reveal. Gradio streams each yield of a generator\nfunction to the browser, so the animation is native Python with no JavaScript — the handler yields\nprogressively longer substrings, word by word, with a blinking caret that disappears when the line\ncompletes.","metadata":{}},{"id":"09e6bef0-b9d3-484a-9bc5-ac08381e18c3","cell_type":"code","source":"# ── Cell 11 · Interface handlers, with typewriter reveal ───────────────────\n#\n# THE TYPING ANIMATION\n# Gradio re-runs an event handler on every keystroke, so animating there would\n# stutter. Instead the handler is a Python generator: it yields progressively\n# longer substrings and Gradio streams each yield to the browser, which produces\n# a genuine typewriter reveal with no JavaScript.\n#\n# Two details make it feel right rather than merely animated:\n#   * both prompts type at once, so the comparison reads as simultaneous;\n#   * the reveal is in whole words, not characters, because character-by-character\n#     on a 30-word prompt is slow enough to become annoying.\n#\n# A blinking caret is appended while typing and removed at the end.\n\nimport time, random\nimport gradio as gr\n\nPICKS_CSV = ROOT / \"user_picks.csv\"\n\nTYPE_CHUNK = 1        # words revealed per frame\nTYPE_DELAY = 0.035    # seconds between frames\n\ndef _typewriter_pair(text_a, text_b, chunk=TYPE_CHUNK, delay=TYPE_DELAY):\n    \"\"\"Yield (partial_a, partial_b) until both are fully revealed.\"\"\"\n    wa, wb = str(text_a).split(), str(text_b).split()\n    steps = max(len(wa), len(wb))\n    for i in range(0, steps + chunk, chunk):\n        pa = \" \".join(wa[:i]) + (\" ▌\" if i < len(wa) else \"\")\n        pb = \" \".join(wb[:i]) + (\" ▌\" if i < len(wb) else \"\")\n        yield pa, pb\n        time.sleep(delay)\n    yield \" \".join(wa), \" \".join(wb)\n\n# ---------------------------------------------------------------- helpers\ndef _banner(kind, msg=\"\"):\n    cls = {\"ready\": \"\", \"age\": \"age\", \"warn\": \"warn\", \"sugg\": \"sugg\"}.get(kind, \"\")\n    head = {\"ready\": \"Ready\", \"age\": \"Age progression\",\n            \"warn\": \"Outside what this system can do\", \"sugg\": \"Suggestion available\"}.get(kind, \"\")\n    body = msg or \"Describe the change you want.\"\n    return f\"<div id='banner' class='{cls}'><b>{head}</b>{body}</div>\"\n\ndef _risk_html(coverage, structure=None, surface=None):\n    lvl, msg = coverage_risk(coverage)\n    cls = {\"high\": \"hi\", \"moderate\": \"mid\", \"low\": \"lo\"}[lvl]\n    out = (f\"<div id='idrisk'>edit area <b>{coverage:.0%}</b> of the face · \"\n           f\"identity risk <span class='{cls}'>{lvl}</span>\")\n    if msg:\n        out += f\" — {msg}\"\n    if structure is not None:\n        ok = \"lo\" if structure <= DRIFT_LIMIT else \"hi\"\n        out += f\" · bone structure moved <span class='{ok}'>{structure:.3f}</span>\"\n        if surface is not None:\n            out += f\" · surface moved <span class='mid'>{surface:.3f}</span>\"\n    return out + \"</div>\"\n\ndef _suggestion_html(s):\n    if not s:\n        return \"\"\n    return (f\"<div id='sugg'><b>From the scored dataset</b>\"\n            f\"<span class='meta'>{s['category']} · match {s['similarity']:.0%} · \"\n            f\"human scores {s['realism']}/{s['identity']}/{s['compliance']} out of 5</span>\"\n            f\"<code>{s['prompt']}</code>\"\n            f\"<span class='meta'>This wording was rated by twelve annotators on a similar \"\n            f\"request. Use it as a third option if the rewrite below is not what you wanted.\"\n            f\"</span></div>\")\n\n# ------------------------------------------------------------------- live\ndef ui_live(img, request):\n    \"\"\"Fast, LOCAL-ONLY preview — banner, mask preview, risk note, suggestion\n    note. Uses only resolve_intent()/resolve_age_request()/build_mask(),\n    none of which touch the network.\n\n    v2 FIX: the previous version called smart_rewrite() -> dspy_rewrite() on\n    every keystroke, i.e. one Gemini API call per character typed. That is\n    what produced the \"this application is currently busy\" toasts (the\n    Gradio queue backing up behind slow API calls) and the typewriter\n    animation that kept visibly \"typing\" after you had already stopped —\n    each queued keystroke's animation played out in turn, arriving late.\n    The two prompts (A/B) are no longer live-typed here at all; they are\n    computed once, after you click Generate, and shown instantly in the\n    'Prompts used' panel — see ui_generate_v2 (Cell 11b).\"\"\"\n    if not (request or \"\").strip():\n        return _banner(\"ready\"), None, \"\", \"\"\n\n    spec, rules, warn = resolve_intent(request)\n    age = resolve_age_request(request)\n    if age:\n        spec = dict(spec)\n        spec[\"parts\"] = [\"face_oval\"]\n        spec[\"protect\"] = [\"eye_aperture\", \"nose_core\"]  # aging: keep eyes AND nose intact\n        spec[\"strength\"] = age[\"strength\"]\n\n    sugg = suggest_from_library(request, spec[\"parts\"])  # local trigram match, no network\n\n    if age and age[\"warning\"]:\n        banner = _banner(\"warn\", age[\"warning\"])\n    elif age:\n        banner = _banner(\"age\", f\"Target age {age['target']}. The mask covers the whole face \"\n                                f\"so skin texture, volume and tissue position can all change, \"\n                                f\"while the face outline is copied from your photo unchanged.\")\n    elif sugg:\n        banner = _banner(\"sugg\", \"A similar request appears in the scored dataset — its \"\n                                 \"wording will be offered as an option after you generate.\")\n    else:\n        banner = _banner(\"ready\", \"Both your wording and a rewritten version are rendered and \"\n                                  \"shown after you click Generate.\")\n\n    meta = spec_summary(spec, rules)\n    if age:\n        meta += f\"\\nage target : {age['target']}   strength {age['strength']:.2f}\"\n    if warn:\n        meta += f\"\\n\\n{warn}\"\n\n    preview, risk = None, \"\"\n    if img is not None:\n        try:\n            m, info = build_mask(img, spec)\n            preview = mask_overlay(img, m)\n            risk = _risk_html(info[\"mask_coverage\"])\n            meta += f\"\\ncoverage   : {info['mask_coverage']:.1%}\"\n        except Exception as e:\n            meta += f\"\\nmask preview failed: {str(e)[:60]}\"\n\n    return banner, preview, meta, risk\n\n# -------------------------------------------------------------- generate\ndef ui_generate(img, request, seed, strength, rand, guard, n_var,\n                progress=gr.Progress()):\n    \"\"\"Render n_var seeds for each wording and return one shuffled gallery.\"\"\"\n    if img is None:\n        raise gr.Error(\"Upload a face photo first.\")\n    if not (request or \"\").strip():\n        raise gr.Error(\"Type an edit request first.\")\n\n    progress(0.05, desc=\"reading the face\")\n    spec, rules, _ = resolve_intent(request)\n    age = resolve_age_request(request)\n    if age:\n        spec = dict(spec)\n        spec[\"parts\"], spec[\"protect\"] = [\"face_oval\"], [\"eye_aperture\"]\n        spec[\"strength\"] = age[\"strength\"]\n\n    if rand:\n        seed = random.randint(0, 2**31 - 1)\n    strength = float(strength or spec[\"strength\"])\n    mask, info = build_mask(img, spec)\n\n    progress(0.15, desc=\"writing the prompts\")\n    rw = smart_rewrite(request, spec[\"parts\"], rules)\n    if age and age[\"vocabulary\"] and rw.get(\"positive\"):\n        if not any(t in rw[\"positive\"].lower() for t in (\"wrinkle\", \"age spot\", \"jowl\", \"fold\")):\n            rw[\"positive\"] = f\"{rw['positive']}, {age['vocabulary']}\"\n    a, b = build_arm_a(request), build_arm_b(rw)\n\n    # ageing legitimately moves soft tissue, so the guard relaxes to bone only\n    age_aware = bool(age)\n\n    n = int(n_var)\n    square, orig = _prep(img)\n    msk = mask.resize((RENDER[\"size\"], RENDER[\"size\"]), Image.BILINEAR)\n    items, structs, surfs = [], [], []\n    total, t0 = 2 * n, time.time()\n\n    for k in range(n):\n        s = int(seed) + k\n        for arm, (pos, neg) in ((\"A\", a), (\"B\", b)):\n            progress(0.15 + 0.8*len(items)/total,\n                     desc=f\"rendering {len(items)+1} of {total}\")\n            if guard:\n                out, g = render_guarded(img, mask, pos, neg, strength, s,\n                                        age_aware=age_aware, verbose=False)\n                structs.append(g[\"structure\"]); surfs.append(g[\"surface\"])\n            else:\n                out = render_one(square, msk, pos, neg, strength, s).resize(orig, Image.LANCZOS)\n                r = drift_report(img, out)\n                structs.append(r[\"structure\"]); surfs.append(r[\"surface\"])\n            items.append(dict(arm=arm, seed=s, img=out))\n\n    dt = round(time.time() - t0, 1)\n\n    # shuffled so position carries no information about which wording produced it\n    order = list(range(len(items)))\n    random.Random(seed).shuffle(order)\n    shown = [items[i] for i in order]\n\n    # the dataset keeps the clean first-seed A/B pair regardless of how many are shown\n    fa = next(it for it in items if it[\"arm\"] == \"A\")\n    fb = next(it for it in items if it[\"arm\"] == \"B\")\n    pid, _ = save_pair(img, mask, fa[\"img\"], fb[\"img\"], request, a, b, rw,\n                       info, rules + ([f\"age:{age['target']}\"] if age else []),\n                       seed, strength, dt, \"studio\")\n\n    gallery = [(it[\"img\"], f\"Option {i+1}\") for i, it in enumerate(shown)]\n    st = [x for x in structs if x is not None]\n    sf = [x for x in surfs if x is not None]\n    risk = _risk_html(info[\"mask_coverage\"],\n                      max(st) if st else None, max(sf) if sf else None)\n    note = (f\"{pid} · {total} options in {dt}s · seeds {seed}–{seed+n-1} · \"\n            f\"strength {strength:.2f}\" + (f\" · age target {age['target']}\" if age else \"\"))\n    state = dict(pair_id=pid, request=request,\n                 options=[dict(arm=it[\"arm\"], seed=it[\"seed\"]) for it in shown])\n    return gallery, note, int(seed), risk, state, \"Click an option to choose it.\"\n\n# ------------------------------------------------------------------ picks\ndef on_pick(state, evt: gr.SelectData):\n    \"\"\"Record the choice and reveal which wording produced it.\"\"\"\n    import csv, datetime\n    import pandas as pd\n    if not state or \"options\" not in state:\n        return \"generate something first\"\n    i = int(evt.index)\n    if i >= len(state[\"options\"]):\n        return \"unknown option\"\n    opt = state[\"options\"][i]\n    new = not PICKS_CSV.exists()\n    with open(PICKS_CSV, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n        w = csv.writer(f)\n        if new:\n            w.writerow([\"pair_id\",\"request\",\"option\",\"arm\",\"seed\",\"timestamp\"])\n        w.writerow([state[\"pair_id\"], state[\"request\"], i+1, opt[\"arm\"], opt[\"seed\"],\n                    datetime.datetime.now().isoformat(timespec=\"seconds\")])\n    label = \"your own wording\" if opt[\"arm\"] == \"A\" else \"the rewritten prompt\"\n    try:\n        t = pd.read_csv(PICKS_CSV).arm.value_counts().to_dict()\n        tally = f\" · running total: your wording {t.get('A',0)}, rewritten {t.get('B',0)}\"\n    except Exception:\n        tally = \"\"\n    return f\"Saved. Option {i+1} came from {label} (seed {opt['seed']}).{tally}\"\n\nprint(\"Cell 11 complete — ui_live, ui_generate, on_pick\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:24.581954Z","iopub.execute_input":"2026-08-20T07:21:24.582271Z","iopub.status.idle":"2026-08-20T07:21:24.613426Z","shell.execute_reply.started":"2026-08-20T07:21:24.582239Z","shell.execute_reply":"2026-08-20T07:21:24.612669Z"}},"outputs":[{"name":"stdout","text":"Cell 11 complete — ui_live, ui_generate, on_pick\n","output_type":"stream"}],"execution_count":15},{"id":"fb056192-2608-45ee-9649-17f162864ad0","cell_type":"markdown","source":"## 12b · Ablation-aware handlers + prompt-assist + edit map\n\nExtension cell — adds new functions only, nothing above is modified.","metadata":{}},{"id":"743fa49b-f37f-45f9-8043-9cfa3098973d","cell_type":"code","source":"# ── Cell 11b · Ablation-aware generate handler + prompt-assist + edit map (extension) ──\n#\n# ui_generate() (Cell 11) is untouched — it is exactly the code path that\n# produced final_dataset.csv and the submitted synopsis's results. This cell\n# adds a separate handler, ui_generate_v2(), which the app (Cell 12) wires the\n# Generate button to instead. It reuses build_arm_a/b, render_one,\n# drift_report and save_pair exactly as before; the two things it adds are\n# the weighted-tier mask (build_mask_tiered, Cell 2b) and the coverage-aware\n# retry loop (render_guarded_adaptive, Cell 10b).\n#\n# v2 FIX — DEFAULT NOW MATCHES THE DIAGRAM\n# The first version of this cell defaulted the \"System\" dropdown to B (the\n# classic strength-only guard), so the coverage-shrink loop your diagram\n# shows (\"Reduce Coverage / Adjust Strength -> Regenerate\") only ran if you\n# went into Advanced and switched it on. That is backwards: the adaptive\n# controller is now the DEFAULT whenever the Identity guard checkbox is on\n# (which is itself on by default), so Generate matches the diagram out of\n# the box. The dropdown is relabelled in plain language and still exposes\n# the classic/legacy conditions for the ablation study in the paper.\n#\n# ABLATION CONDITIONS (dropdown -> internal code)\n#   D  (default)  adaptive coverage + identity guard — coverage AND strength\n#                 are both retry variables (matches the diagram)\n#   B             classic — build_mask() binary mask, strength-only guard —\n#                 exactly today's/submitted behaviour, for direct comparison\n#   C             adaptive coverage mask, single render, no retry loop\n#   E             D, plus the scored-library suggestion surfaced in the note\n#   A             baseline — no landmark mask, no guard (floor condition)\n#\n# DSPy stays exactly as it is everywhere above: every request is still\n# rewritten and both wordings are still rendered and shuffled (per your\n# decision to keep A/B as the default). \"Write Prompt for Me\" is a SEPARATE,\n# additional affordance — a rough draft can be cleaned up before it reaches\n# the request box — it does not gate or replace the rewrite that already\n# happens at generation time. The two final prompts are only ever shown\n# after you click Generate (in a collapsed \"Prompts used\" panel), never\n# live while typing — see Cell 11's ui_live for why.\n\nSYSTEM_MODES = {\n    \"Adaptive coverage + identity guard (recommended \\u2014 matches the system diagram)\":\n        dict(code=\"D\", tiered=True,  guard=True,  adaptive=True),\n    \"Classic \\u2014 edit-aware mask, strength-only guard (matches the submitted dataset)\":\n        dict(code=\"B\", tiered=False, guard=True,  adaptive=False),\n    \"Adaptive coverage mask only, no retry loop (System C \\u2014 ablation)\":\n        dict(code=\"C\", tiered=True,  guard=False, adaptive=False),\n    \"Adaptive coverage + guard + scored-library suggestion (System E \\u2014 ablation)\":\n        dict(code=\"E\", tiered=True,  guard=True,  adaptive=True),\n    \"Baseline \\u2014 no landmark mask, no guard (System A \\u2014 ablation)\":\n        dict(code=\"A\", tiered=False, guard=False, adaptive=False),\n}\nSYSTEM_MODE_DEFAULT = \"Adaptive coverage + identity guard (recommended \\u2014 matches the system diagram)\"\n\ndef ui_write_prompt_for_me(rough_text):\n    \"\"\"Optional assist: rewrite a rough draft on demand, without touching the\n    main request box or triggering generation. This is the ONLY place DSPy\n    (or the scored-dataset library) runs outside of Generate itself, and only\n    on a click, never live while typing.\n\n    DATASET-INFORMED: if a close, well-scored match already exists in the\n    human-scored library (suggest_from_library, Cell 8) it is used directly —\n    it is already a human-validated prompt, which is a better bet than a\n    fresh zero-shot rewrite. Otherwise this falls through to dspy_rewrite(),\n    which is itself conditioned on the library via LabeledFewShot (Cell 8).\n\n    ANIMATED WHILE WAITING: this is a generator now, but — unlike the old\n    per-keystroke ui_live — it only ever runs once per click, so animating it\n    costs nothing extra. It yields a \"thinking\" placeholder immediately, then\n    reveals the result word-by-word once the (single) network call returns,\n    instead of the box just sitting on a spinner.\n    \"\"\"\n    rough_text = (rough_text or \"\").strip()\n    if not rough_text:\n        yield \"Type a rough description on the left first.\"\n        return\n\n    yield \"✍️ writing your prompt…\"\n\n    spec, rules, _ = resolve_intent(rough_text)\n    sugg = suggest_from_library(rough_text, spec[\"parts\"])\n    if sugg and sugg[\"similarity\"] >= 0.55 and sugg[\"realism\"] >= 4 and sugg[\"identity\"] >= 4:\n        text = sugg[\"prompt\"]   # a proven, human-scored prompt for a near-identical request\n    else:\n        rw = dspy_rewrite(rough_text, spec[\"parts\"])\n        text = (rw.get(\"positive\") or \"\").strip()\n\n    if not text:\n        yield \"Could not rewrite that — try adding a bit more detail.\"\n        return\n\n    words = text.split()\n    for i in range(1, len(words) + 1):\n        yield \" \".join(words[:i]) + (\" ▌\" if i < len(words) else \"\")\n        time.sleep(TYPE_DELAY)\n\ndef ui_generate_refined(img, draft_text, refined_text, seed, strength, rand, guard, n_var,\n                        system_mode, progress=gr.Progress()):\n    \"\"\"Skip A/B entirely: render ONLY the refined ('Write Prompt for Me')\n    wording, n_var seeds, no blind pair, no shuffle. This is the fast path\n    for people who used the prompt assist — the full blind A/B comparison\n    (ui_generate_v2) stays the default for anyone typing their own wording\n    directly, which is what keeps that comparison meaningful for the study.\n\n    The mask/region is resolved from the ROUGH DRAFT, not the rewritten text\n    — the draft still contains the trigger words resolve_intent() matches on\n    (\"beard\", \"wrinkles\", ...); the polished rewrite may drop or rephrase\n    them. Logged to the same v2 schema as System D, tagged with a '-quick'\n    suffix so it's easy to exclude from the ablation analysis.\n    \"\"\"\n    if img is None:\n        raise gr.Error(\"Upload a face photo first.\")\n    if not (refined_text or \"\").strip():\n        raise gr.Error(\"Click '✨ Write Prompt for Me' first — there's nothing to generate yet.\")\n\n    cfg = SYSTEM_MODES.get(system_mode, SYSTEM_MODES[SYSTEM_MODE_DEFAULT])\n    intent_source = (draft_text or \"\").strip() or refined_text\n\n    progress(0.05, desc=\"reading the face\")\n    spec, rules, _ = resolve_intent(intent_source)\n    age = resolve_age_request(intent_source)\n    if age:\n        spec = dict(spec)\n        spec[\"parts\"], spec[\"protect\"] = [\"face_oval\"], [\"eye_aperture\", \"nose_core\"]\n        spec[\"strength\"] = age[\"strength\"]\n\n    if rand:\n        seed = random.randint(0, 2**31 - 1)\n    strength = float(strength or spec[\"strength\"])\n\n    mask, info = (build_mask_tiered(img, spec) if cfg[\"tiered\"] else build_mask(img, spec))\n    pos = f\"{clean_prompt(refined_text)}, {IDENTITY_ANCHOR}\"\n    neg = BASE_NEGATIVE\n    age_aware = bool(age)\n\n    n = int(n_var)\n    square, orig = _prep(img)\n    msk = mask.resize((RENDER[\"size\"], RENDER[\"size\"]), Image.BILINEAR)\n    items, structs, surfs, ctrl_logs = [], [], [], []\n    total, t0 = n, time.time()\n\n    for k in range(n):\n        s = int(seed) + k\n        progress(0.15 + 0.8*k/total, desc=f\"rendering {k+1} of {total}\")\n        if cfg[\"adaptive\"] and guard:\n            out, g = render_guarded_adaptive(img, spec, pos, neg, strength, s, age_aware=age_aware)\n            structs.append(g[\"structure\"]); surfs.append(g[\"surface\"]); ctrl_logs.append(g)\n        elif guard:\n            out, g = render_guarded(img, mask, pos, neg, strength, s, age_aware=age_aware)\n            structs.append(g[\"structure\"]); surfs.append(g[\"surface\"]); ctrl_logs.append(g)\n        else:\n            out = render_one(square, msk, pos, neg, strength, s).resize(orig, Image.LANCZOS)\n            r = drift_report(img, out)\n            structs.append(r[\"structure\"]); surfs.append(r[\"surface\"]); ctrl_logs.append(None)\n        items.append(out)\n\n    dt = round(time.time() - t0, 1)\n    ctrl0 = next((c for c in ctrl_logs if c), None)\n    rw_stub = dict(source=\"dspy-refined-quick\", flags=[], latency_s=0.0)\n    pid, _ = save_pair_v2(img, mask, items[0], items[0], intent_source,\n                          (pos, neg), (pos, neg), rw_stub, info, rules,\n                          seed, strength, dt, \"studio-quick\",\n                          system_mode=f'{cfg[\"code\"]}-quick', ctrl=ctrl0)\n\n    gallery = [(im, f\"Option {i+1}\") for i, im in enumerate(items)]\n    st = [x for x in structs if x is not None]; sf = [x for x in surfs if x is not None]\n    risk = _risk_html(info[\"mask_coverage\"], max(st) if st else None, max(sf) if sf else None)\n    note = f\"{pid} · quick generate (no A/B) · {total} option(s) in {dt}s · seeds {seed}–{seed+n-1}\"\n    return gallery, note, int(seed), risk\n\ndef ui_show_edit_map(img, request):\n    \"\"\"'Show Edit Map': protected (untouched) / low-priority (amber) /\n    high-priority (red) regions for the current request, via the weighted-\n    tier mask (Cell 2b) regardless of which system_mode is selected for\n    generation. Returns a single gr.update so visibility and content change\n    together, and the caller (Cell 12) resets visibility=False whenever the\n    photo or request changes, so a stale map is never left on screen.\"\"\"\n    if img is None or not (request or \"\").strip():\n        return gr.update(visible=True, value=None)\n    spec, rules, _ = resolve_intent(request)\n    age = resolve_age_request(request)\n    if age:\n        spec = dict(spec); spec[\"parts\"] = [\"face_oval\"]; spec[\"protect\"] = [\"eye_aperture\", \"nose_core\"]\n    try:\n        mask, _info = build_mask_tiered(img, spec)\n        return gr.update(visible=True, value=tiered_overlay(img, mask))\n    except Exception:\n        return gr.update(visible=True, value=None)\n\ndef ui_generate_v2(img, request, seed, strength, rand, guard, n_var, system_mode,\n                   progress=gr.Progress()):\n    \"\"\"Same contract as ui_generate() (Cell 11), plus a `system_mode` switch,\n    and TWO extra return values: the final A/B prompt text, shown once after\n    generation completes (no live typewriter, no per-keystroke cost).\"\"\"\n    if img is None:\n        raise gr.Error(\"Upload a face photo first.\")\n    if not (request or \"\").strip():\n        raise gr.Error(\"Type an edit request first.\")\n\n    cfg = SYSTEM_MODES.get(system_mode, SYSTEM_MODES[SYSTEM_MODE_DEFAULT])\n\n    progress(0.05, desc=\"reading the face\")\n    spec, rules, _ = resolve_intent(request)\n    age = resolve_age_request(request)\n    if age:\n        spec = dict(spec)\n        spec[\"parts\"], spec[\"protect\"] = [\"face_oval\"], [\"eye_aperture\", \"nose_core\"]\n        spec[\"strength\"] = age[\"strength\"]\n    if cfg[\"code\"] == \"A\":\n        spec = dict(spec, parts=[\"face_oval\"], protect=[], grow=0.10, blur=8)\n\n    if rand:\n        seed = random.randint(0, 2**31 - 1)\n    strength = float(strength or spec[\"strength\"])\n\n    if cfg[\"tiered\"]:\n        mask, info = build_mask_tiered(img, spec)\n    else:\n        mask, info = build_mask(img, spec)\n\n    progress(0.15, desc=\"writing the prompts\")\n    rw = smart_rewrite(request, spec[\"parts\"], rules)\n    if age and age[\"vocabulary\"] and rw.get(\"positive\"):\n        if not any(t in rw[\"positive\"].lower() for t in (\"wrinkle\", \"age spot\", \"jowl\", \"fold\")):\n            rw[\"positive\"] = f\"{rw['positive']}, {age['vocabulary']}\"\n    a, b = build_arm_a(request), build_arm_b(rw)\n    age_aware = bool(age)\n\n    sugg = suggest_from_library(request, spec[\"parts\"]) if cfg[\"code\"] == \"E\" else None\n\n    n = int(n_var)\n    square, orig = _prep(img)\n    msk = mask.resize((RENDER[\"size\"], RENDER[\"size\"]), Image.BILINEAR)\n    items, structs, surfs, ctrl_logs = [], [], [], []\n    total, t0 = 2 * n, time.time()\n\n    for k in range(n):\n        s = int(seed) + k\n        for arm, (pos, neg) in ((\"A\", a), (\"B\", b)):\n            progress(0.15 + 0.8*len(items)/total, desc=f\"rendering {len(items)+1} of {total}\")\n            if cfg[\"adaptive\"] and guard:\n                out, g = render_guarded_adaptive(img, spec, pos, neg, strength, s,\n                                                 age_aware=age_aware, verbose=False)\n                structs.append(g[\"structure\"]); surfs.append(g[\"surface\"]); ctrl_logs.append(g)\n            elif guard:\n                out, g = render_guarded(img, mask, pos, neg, strength, s,\n                                        age_aware=age_aware, verbose=False)\n                structs.append(g[\"structure\"]); surfs.append(g[\"surface\"]); ctrl_logs.append(g)\n            else:\n                out = render_one(square, msk, pos, neg, strength, s).resize(orig, Image.LANCZOS)\n                r = drift_report(img, out)\n                structs.append(r[\"structure\"]); surfs.append(r[\"surface\"]); ctrl_logs.append(None)\n            items.append(dict(arm=arm, seed=s, img=out))\n\n    dt = round(time.time() - t0, 1)\n    order = list(range(len(items))); random.Random(seed).shuffle(order)\n    shown = [items[i] for i in order]\n\n    fa = next(it for it in items if it[\"arm\"] == \"A\")\n    fb = next(it for it in items if it[\"arm\"] == \"B\")\n    ctrl0 = next((c for c in ctrl_logs if c), None)\n    pid, _ = save_pair_v2(img, mask, fa[\"img\"], fb[\"img\"], request, a, b, rw, info,\n                          rules + ([f\"age:{age['target']}\"] if age else []),\n                          seed, strength, dt, \"studio\", system_mode=cfg[\"code\"], ctrl=ctrl0)\n\n    gallery = [(it[\"img\"], f\"Option {i+1}\") for i, it in enumerate(shown)]\n    st = [x for x in structs if x is not None]; sf = [x for x in surfs if x is not None]\n    risk = _risk_html(info[\"mask_coverage\"], max(st) if st else None, max(sf) if sf else None)\n    note = (f\"{pid} \\u00b7 system {cfg['code']} \\u00b7 {total} options in {dt}s \\u00b7 \"\n            f\"seeds {seed}\\u2013{seed+n-1} \\u00b7 strength {strength:.2f}\"\n            + (f\" \\u00b7 age target {age['target']}\" if age else \"\"))\n    if cfg[\"adaptive\"] and ctrl0 and ctrl0.get(\"iterations\", 1) > 1:\n        note += f\" \\u00b7 guard fired: coverage reduced to {ctrl0['coverage_final']:.1%} over {ctrl0['iterations']} tries\"\n    if sugg:\n        note += f\" \\u00b7 library match {sugg['similarity']:.0%}\"\n    state = dict(pair_id=pid, request=request,\n                 options=[dict(arm=it[\"arm\"], seed=it[\"seed\"]) for it in shown])\n    return gallery, note, int(seed), risk, state, \"Click an option to choose it.\", a[0], b[0]\n\nprint(\"Cell 11b complete — ui_generate_v2, ui_write_prompt_for_me, ui_show_edit_map\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:24.614607Z","iopub.execute_input":"2026-08-20T07:21:24.61505Z","iopub.status.idle":"2026-08-20T07:21:24.651747Z","shell.execute_reply.started":"2026-08-20T07:21:24.615028Z","shell.execute_reply":"2026-08-20T07:21:24.650918Z"}},"outputs":[{"name":"stdout","text":"Cell 11b complete — ui_generate_v2, ui_write_prompt_for_me, ui_show_edit_map\n","output_type":"stream"}],"execution_count":16},{"id":"1162b432-88ee-4e27-bff4-14a06f5b59a5","cell_type":"markdown","source":"## 13 · The app\n\nLaunches non-blocking. Dark mode forces itself.","metadata":{}},{"id":"37faf88a-0617-475b-bbdc-e5460e2daaab","cell_type":"code","source":"# ── Cell 12 · Vision Studio — the app ──────────────────────────────────────\n#   Studio   edit one photo, watch both prompts type out, pick from the options\n#   Batch    run many requests across many faces unattended\n#   Gallery  browse everything made in this session\n#\n# Fully dark: the page forces ?__theme=dark on load AND every colour token sets\n# both its light and _dark variant. Gradio otherwise follows the browser's\n# system preference and renders white panels on a dark page.\n\nimport gradio as gr\n\nTHEME = gr.themes.Base(\n    primary_hue=gr.themes.colors.orange, secondary_hue=gr.themes.colors.amber,\n    neutral_hue=gr.themes.colors.zinc,\n    font=[gr.themes.GoogleFont(\"Space Grotesk\"), \"Inter\", \"sans-serif\"],\n    font_mono=[gr.themes.GoogleFont(\"JetBrains Mono\"), \"monospace\"],\n).set(\n    body_background_fill=\"#07080b\",            body_background_fill_dark=\"#07080b\",\n    body_text_color=\"#f2f4f8\",                 body_text_color_dark=\"#f2f4f8\",\n    body_text_color_subdued=\"#8b95a5\",         body_text_color_subdued_dark=\"#8b95a5\",\n    background_fill_primary=\"#0f1218\",         background_fill_primary_dark=\"#0f1218\",\n    background_fill_secondary=\"#141821\",       background_fill_secondary_dark=\"#141821\",\n    block_background_fill=\"#0f1218\",           block_background_fill_dark=\"#0f1218\",\n    block_label_background_fill=\"#141821\",     block_label_background_fill_dark=\"#141821\",\n    block_label_text_color=\"#9aa4b4\",          block_label_text_color_dark=\"#9aa4b4\",\n    block_title_text_color=\"#e8ecf3\",          block_title_text_color_dark=\"#e8ecf3\",\n    block_border_color=\"#212836\",              block_border_color_dark=\"#212836\",\n    border_color_primary=\"#212836\",            border_color_primary_dark=\"#212836\",\n    input_background_fill=\"#0b0e14\",           input_background_fill_dark=\"#0b0e14\",\n    input_border_color=\"#232b3a\",              input_border_color_dark=\"#232b3a\",\n    input_placeholder_color=\"#5c6676\",         input_placeholder_color_dark=\"#5c6676\",\n    button_primary_background_fill=\"linear-gradient(97deg,#ff5f1f,#ffb020)\",\n    button_primary_background_fill_dark=\"linear-gradient(97deg,#ff5f1f,#ffb020)\",\n    button_primary_text_color=\"#160a02\",       button_primary_text_color_dark=\"#160a02\",\n    button_secondary_background_fill=\"#151a24\",button_secondary_background_fill_dark=\"#151a24\",\n    button_secondary_text_color=\"#e6eaf1\",     button_secondary_text_color_dark=\"#e6eaf1\",\n    slider_color=\"#ff7a2f\",                    slider_color_dark=\"#ff7a2f\",\n    panel_background_fill=\"#0f1218\",           panel_background_fill_dark=\"#0f1218\",\n)\n\nFORCE_DARK = \"\"\"\nfunction(){\n  const u = new URL(window.location);\n  if (u.searchParams.get('__theme') !== 'dark') {\n    u.searchParams.set('__theme','dark'); window.location.replace(u.href);\n  }\n}\n\"\"\"\n\nCSS = \"\"\"\n.gradio-container{max-width:100%!important;\n  background:\n    radial-gradient(1100px 520px at 8% -12%, rgba(255,95,31,.13), transparent 60%),\n    radial-gradient(900px 460px at 102% -6%, rgba(255,176,32,.09), transparent 55%),\n    #07080b!important}\n.block,.form,.panel,.gr-box,.gr-panel,.tabitem,.wrap,.container,.gallery,\n.grid-wrap,.thumbnail-item,.image-container,.file-preview,.upload-container{\n  background-color:#0f1218!important;border-color:#212836!important;color:#eef2f8!important}\ninput,textarea,select{background-color:#0b0e14!important;color:#eef2f8!important;\n  border-color:#232b3a!important}\nlabel,.label-wrap span,.block-title{color:#9aa4b4!important}\n::placeholder{color:#5c6676!important}\n\n#hero{position:relative;overflow:hidden;border-radius:22px;padding:28px 32px;margin-bottom:8px;\n  border:1px solid #241c17;\n  background:linear-gradient(115deg,#120a05 0%,#0d0f15 55%,#0a0c11 100%)}\n#hero:after{content:\"\";position:absolute;inset:0;pointer-events:none;\n  background:radial-gradient(560px 200px at 0% 0%, rgba(255,95,31,.22), transparent 70%)}\n#hero .wm{font-family:'Space Grotesk';font-weight:700;font-size:44px;line-height:1;\n  letter-spacing:-.03em;background:linear-gradient(96deg,#ffb020,#ff5f1f 62%);\n  -webkit-background-clip:text;background-clip:text;color:transparent}\n#hero .sub{color:#8b95a5;font-size:13.5px;margin-top:10px;max-width:680px}\n#hero .rail{position:absolute;right:32px;bottom:28px;text-align:right;font-size:11.5px;\n  color:#6f7a8b;line-height:1.95;letter-spacing:.03em}\n#hero .rail b{color:#ffb020;font-weight:600}\n\n#banner{border-radius:14px;padding:13px 18px;margin:4px 0 10px 0;font-size:13.5px;\n  line-height:1.55;border:1px solid #212836;background:#0f1218;color:#9aa4b4}\n#banner b{display:block;font-family:'Space Grotesk',sans-serif;font-size:15px;\n  margin-bottom:3px;color:#c2cbd8}\n#banner.age{border-color:#ff7a2f;\n  background:linear-gradient(97deg,rgba(255,95,31,.16),rgba(255,176,32,.06));color:#ffd7b0}\n#banner.age b{color:#ffb020}\n#banner.warn{border-color:#8a4030;background:rgba(150,60,45,.14);color:#ffb9a6}\n#banner.warn b{color:#ff8a6b}\n#banner.sugg{border-color:#3d6fb4;background:rgba(61,111,180,.12);color:#bcd2ef}\n#banner.sugg b{color:#7fb0ee}\n\n#idrisk{font-size:12.5px;color:#8b95a5;padding:6px 2px}\n#idrisk .hi{color:#ff8a6b;font-weight:600}\n#idrisk .mid{color:#ffb020}\n#idrisk .lo{color:#7ee2a8}\n\n#sugg{border:1px solid #2a3a52;border-left:3px solid #3d6fb4;border-radius:10px;\n  padding:12px 16px;margin-top:8px;background:rgba(61,111,180,.07)}\n#sugg b{display:block;font-family:'Space Grotesk',sans-serif;font-size:13.5px;\n  color:#7fb0ee;margin-bottom:4px}\n#sugg .meta{display:block;font-size:11.5px;color:#7c8698;margin:3px 0 6px 0}\n#sugg code{display:block;font-family:'JetBrains Mono',monospace;font-size:12px;\n  line-height:1.6;color:#d6e2f2;background:#0b0e14;border-radius:7px;padding:9px 12px;\n  white-space:pre-wrap}\n\n.armA textarea{border-left:3px solid #3b475a!important}\n.armB textarea{border-left:3px solid #ff7a2f!important}\n#meta textarea,.armA textarea,.armB textarea,#log textarea{\n  font-family:'JetBrains Mono',ui-monospace,monospace!important;\n  font-size:12.5px!important;line-height:1.7!important}\n\n.tab-nav button{color:#7c8698!important;border:none!important;background:transparent!important;\n  font-weight:500!important}\n.tab-nav button.selected{color:#ffb020!important;border-bottom:2px solid #ff7a2f!important}\nbutton.primary{border:none!important;font-weight:600!important;\n  box-shadow:0 6px 22px -10px rgba(255,95,31,.75)!important}\nfooter,.built-with,.show-api{display:none!important}\n\"\"\"\n\nHERO = \"\"\"<div id='hero'>\n  <div class='wm'>Vision Studio</div>\n  <div class='sub'>Describe a change in your own words. The system finds the right part of the\n  face, decides how much of it actually needs to change, writes two versions of the prompt, and\n  renders several options from each — you choose. Age progression, appearance variation and\n  cosmetic edits, with identity checked automatically and the edit area shown on request.</div>\n  <div class='rail'><b>A</b> &nbsp;your words<br><b>B</b> &nbsp;rewritten<br>\n  identical mask, seed and strength</div></div>\"\"\"\n\nEXAMPLES = [\"make her look 65 years old\",\n            \"show him in his eighties\",\n            \"remove his beard completely so he is clean shaven\",\n            \"remove all her makeup so she looks natural\",\n            \"make her look ten years younger\"]\n\n# ----------------------------------------------------------------- Batch\ndef ui_scan(limit):\n    global FACES\n    FACES = find_faces(limit=int(limit), verbose=False)\n    return (f\"{len(FACES)} usable faces found\" if FACES else\n            \"no faces — attach a face dataset with '+ Add Data', or upload photos \"\n            \"to /kaggle/working/faces/\")\n\ndef ui_batch(target, session):\n    if not FACES:\n        yield \"press 'Scan for faces' first\"; return\n    log = []\n    for line in batch_generate(FACES, int(target), session or \"batch1\"):\n        log.append(line); yield \"\\n\".join(log[-24:])\n\n# --------------------------------------------------------------- Gallery\ndef _gallery(n):\n    df = load_pairs()\n    if df.empty:\n        return [], \"nothing made yet\"\n    df = df.tail(int(n)).iloc[::-1]\n    items = []\n    for r in df.itertuples():\n        for p, lab in ((r.image_a, \"A · your words\"), (r.image_b, \"B · rewritten\")):\n            if isinstance(p, str) and os.path.exists(p):\n                items.append((p, f\"{lab} — {str(r.edit_request)[:44]}\"))\n    return items, f\"{len(df)} most recent\"\n\ndef _detail(n):\n    df = load_pairs()\n    if df.empty:\n        return None, None, None, \"\", \"\", \"\"\n    df = df.iloc[::-1].reset_index(drop=True)\n    i = int(min(max(0, n), len(df)-1)); r = df.iloc[i]\n    def op(p):\n        try: return Image.open(p).convert(\"RGB\")\n        except Exception: return None\n    info = (f'\"{r.edit_request}\"\\n\\nseed {int(r.seed)}   strength {float(r.strength):.2f}\\n'\n            f\"mask {r.mask_parts}\\nrewriter {r.rewrite_source}\")\n    return op(r.source_path), op(r.image_a), op(r.image_b), info, str(r.prompt_a), str(r.prompt_b)\n\n# ---------------------------------------------------------------- layout\nwith gr.Blocks(css=CSS, theme=THEME, js=FORCE_DARK, title=\"Vision Studio\") as demo:\n    gr.HTML(HERO)\n    with gr.Tabs():\n        with gr.Tab(\"Studio\"):\n            banner = gr.HTML(_banner(\"ready\"))\n            with gr.Row():\n                with gr.Column(scale=1):\n                    img_in  = gr.Image(label=\"Your photo\", type=\"pil\", height=300)\n                    request = gr.Textbox(label=\"What would you like to change?\", lines=3,\n                                         placeholder=\"make her look 65 years old\")\n                    gr.Examples(EXAMPLES, inputs=request, label=\"Try one\")\n                    with gr.Accordion(\"✨ Write Prompt for Me (optional)\", open=False):\n                        gr.Markdown(\"Type a rough description, get a cleaned-up version back, \"\n                                    \"review and edit it, then use it as your request. This does \"\n                                    \"not change what happens when you click Generate below — \"\n                                    \"both your wording and a rewrite are still rendered and shown.\")\n                        draft = gr.Textbox(label=\"Rough description\", lines=2,\n                                           placeholder=\"make him old man 80 wrinkles\")\n                        write_btn = gr.Button(\"✨ Write Prompt for Me\")\n                        refined = gr.Textbox(label=\"AI-refined prompt\", lines=3, interactive=True)\n                        use_refined = gr.Button(\"Use this prompt → Generate (skips A/B)\",\n                                                variant=\"primary\")\n                    mask_p = gr.Image(label=\"What will be edited\", height=250)\n                    with gr.Row():\n                        map_btn = gr.Button(\"Show edit map\", size=\"sm\")\n                    edit_map_out = gr.Image(label=\"Edit map — protected / low / high priority\",\n                                            height=250, visible=False)\n                    risk   = gr.HTML(\"\")\n                    n_var  = gr.Slider(1, 4, value=2, step=1,\n                                label=\"Options per wording (2 wordings × this many)\")\n                    with gr.Accordion(\"Advanced\", open=False):\n                        strength = gr.Slider(.20, .80, value=.46, step=.01,\n                                             label=\"Strength — higher changes more\")\n                        seed_in  = gr.Number(value=1234, precision=0, label=\"Seed\")\n                        rand     = gr.Checkbox(value=True, label=\"New seed each time\")\n                        guard    = gr.Checkbox(value=True,\n                                    label=\"Identity guard — retry if bone structure shifts\")\n                        system_mode = gr.Dropdown(list(SYSTEM_MODES.keys()),\n                                    value=SYSTEM_MODE_DEFAULT,\n                                    label=\"System (ablation study)\")\n                    go = gr.Button(\"Generate options\", variant=\"primary\", size=\"lg\")\n                with gr.Column(scale=2):\n                    with gr.Accordion(\"Prompts used (A vs B)\", open=False):\n                        gr.Markdown(\"Filled in after you click Generate — both wordings are \"\n                                    \"always rendered, this just shows you the text.\")\n                        with gr.Row():\n                            pa = gr.Textbox(label=\"A · your words\", lines=4,\n                                            elem_classes=\"armA\", interactive=False)\n                            pb = gr.Textbox(label=\"B · rewritten\", lines=4,\n                                            elem_classes=\"armB\", interactive=False)\n                    sugg_box = gr.HTML(\"\")\n                    meta = gr.Textbox(label=\"Details\", lines=5, elem_id=\"meta\",\n                                      interactive=False)\n                    gr.Markdown(\"### Pick the one you like\\n\"\n                                \"Order is shuffled and the labels are hidden, so you judge the \"\n                                \"picture rather than the wording. Clicking reveals which produced it.\")\n                    gal_out = gr.Gallery(label=\"Your options\", columns=4, height=430,\n                                         object_fit=\"cover\", allow_preview=True)\n                    picked  = gr.Textbox(label=\"\", show_label=False, interactive=False)\n                    note    = gr.Textbox(label=\"\", show_label=False, interactive=False)\n                    gen_state = gr.State({})\n\n        with gr.Tab(\"Batch\"):\n            gr.Markdown(\"Run the built-in request set across many faces unattended. \"\n                        \"Resumable — rerun after an interruption and it skips what exists.\")\n            with gr.Row():\n                lim  = gr.Slider(5, 60, value=40, step=5, label=\"Faces to scan\")\n                scan = gr.Button(\"Scan for faces\")\n            scan_out = gr.Textbox(label=\"Faces\", lines=2, interactive=False)\n            with gr.Row():\n                target = gr.Slider(10, 400, value=100, step=10, label=\"How many edits\")\n                bsess  = gr.Textbox(value=\"batch1\", label=\"Tag\")\n            brun = gr.Button(\"Run batch\", variant=\"primary\", size=\"lg\")\n            blog = gr.Textbox(label=\"Progress\", lines=16, elem_id=\"log\", interactive=False)\n\n        with gr.Tab(\"Gallery\"):\n            with gr.Row():\n                n_show  = gr.Slider(4, 60, value=12, step=4, label=\"Recent edits\")\n                refresh = gr.Button(\"Refresh\", variant=\"primary\")\n            g_note = gr.Textbox(label=\"\", show_label=False, interactive=False)\n            gal    = gr.Gallery(label=\"Recent\", columns=6, height=340)\n            gr.Markdown(\"### Look at one\")\n            pick = gr.Slider(0, 200, value=0, step=1, label=\"Edit (0 = most recent)\")\n            with gr.Row():\n                d_src = gr.Image(label=\"Original\", height=300)\n                d_a   = gr.Image(label=\"A · your words\", height=300)\n                d_b   = gr.Image(label=\"B · rewritten\", height=300)\n            d_info = gr.Textbox(label=\"Details\", lines=6, elem_id=\"log\", interactive=False)\n            with gr.Row():\n                d_pa = gr.Textbox(label=\"A · prompt\", lines=3, elem_classes=\"armA\",\n                                  interactive=False)\n                d_pb = gr.Textbox(label=\"B · prompt\", lines=3, elem_classes=\"armB\",\n                                  interactive=False)\n\n    # ---- wiring ----\n    # ui_live is now a plain (non-generator) function with no network calls —\n    # see Cell 11 for why. trigger_mode=\"always_last\" is kept as a defensive\n    # debounce where the installed Gradio version supports it; without it,\n    # ui_live's near-instant local-only work means duplicate calls no longer\n    # pile up the way the old per-keystroke DSPy call did.\n    live_out = [banner, mask_p, meta, risk]\n    try:\n        request.change(ui_live, [img_in, request], live_out,\n                       trigger_mode=\"always_last\", show_progress=\"hidden\")\n    except TypeError:\n        request.change(ui_live, [img_in, request], live_out, show_progress=\"hidden\")\n    img_in.change(ui_live, [img_in, request], live_out, show_progress=\"hidden\")\n\n    # reset the edit map whenever the photo or request changes, so it never\n    # shows a stale map left over from a previous request\n    request.change(lambda: gr.update(visible=False, value=None), None, edit_map_out)\n    img_in.change(lambda: gr.update(visible=False, value=None), None, edit_map_out)\n\n    go.click(ui_generate_v2,\n             [img_in, request, seed_in, strength, rand, guard, n_var, system_mode],\n             [gal_out, note, seed_in, risk, gen_state, picked, pa, pb])\n    gal_out.select(on_pick, gen_state, picked)\n\n    write_btn.click(ui_write_prompt_for_me, draft, refined)\n    # \"Use this prompt\": copy into the request box for the record, THEN\n    # generate immediately with ONLY the refined wording — no A/B, no blind\n    # gallery. The normal A/B comparison stays default for anyone typing\n    # their own request directly and clicking \"Generate options\" below.\n    use_refined.click(lambda t: t, refined, request).then(\n        ui_generate_refined,\n        [img_in, draft, refined, seed_in, strength, rand, guard, n_var, system_mode],\n        [gal_out, note, seed_in, risk])\n    map_btn.click(ui_show_edit_map, [img_in, request], edit_map_out)\n\n    scan.click(ui_scan, lim, scan_out)\n    brun.click(ui_batch, [target, bsess], blog)\n\n    refresh.click(_gallery, n_show, [gal, g_note])\n    n_show.change(_gallery, n_show, [gal, g_note])\n    pick.change(_detail, pick, [d_src, d_a, d_b, d_info, d_pa, d_pb])\n    demo.load(_gallery, n_show, [gal, g_note])\n\ntry:\n    demo.queue(max_size=16, default_concurrency_limit=4)\nexcept TypeError:\n    demo.queue(max_size=16)\ndemo.launch(share=True, prevent_thread_lock=True)\nprint(\"\\nOpen the *.gradio.live link. Dark mode forces itself.\")\nprint(\"Cells below stay runnable while the app is up.\") \n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-20T07:21:24.652821Z","iopub.execute_input":"2026-08-20T07:21:24.653077Z","iopub.status.idle":"2026-08-20T07:21:27.708025Z","shell.execute_reply.started":"2026-08-20T07:21:24.653056Z","shell.execute_reply":"2026-08-20T07:21:27.707424Z"}},"outputs":[{"name":"stdout","text":"* Running on local URL:  http://127.0.0.1:7860\n* Running on public URL: https://d45a9a7151be211085.gradio.live\n\nThis share link expires in 1 week. For free permanent hosting and GPU upgrades, run `gradio deploy` from the terminal in the working directory to deploy to Hugging Face Spaces (https://huggingface.co/spaces)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"<div><iframe src=\"https://d45a9a7151be211085.gradio.live\" width=\"100%\" height=\"500\" allow=\"autoplay; camera; microphone; clipboard-read; clipboard-write;\" frameborder=\"0\" allowfullscreen></iframe></div>"},"metadata":{}},{"name":"stdout","text":"\nOpen the *.gradio.live link. Dark mode forces itself.\nCells below stay runnable while the app is up.\nloading Uminosachi/realisticVisionV51_v51VAE-inpainting ...\n","output_type":"stream"},{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and f